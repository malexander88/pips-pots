diff --git a/vite.notices.ts b/vite.notices.ts
new file mode 100644
index 0000000..c68799b
--- /dev/null
+++ b/vite.notices.ts
@@ -0,0 +1,67 @@
+import { existsSync, readdirSync, readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+
+/**
+ * release-1: writes THIRD_PARTY_NOTICES.txt next to the build, with the licence text of every
+ * npm package that ends up in the bundle (found from the modules rendered into the bundle). The grown-up
+ * panel's credits sheet links to it.
+ */
+export function thirdPartyNotices() {
+  return {
+    name: "third-party-notices",
+    apply: "build" as const,
+    generateBundle(
+      this: { emitFile(f: { type: "asset"; fileName: string; source: string }): void },
+      _options: unknown,
+      bundle: Record<string, { type: string; modules?: Record<string, { renderedLength: number }> }>,
+    ) {
+      const roots = new Map<string, string>();
+      // Only modules whose code is actually in the output (tree-shaken ones are left out).
+      const ids: string[] = [];
+      for (const out of Object.values(bundle)) {
+        if (out.type !== "chunk" || !out.modules) continue;
+        for (const [id, m] of Object.entries(out.modules)) if (m.renderedLength > 0) ids.push(id);
+      }
+      for (const id of ids) {
+        const clean = id.replace(/^\0/, "").split("?")[0]!;
+        const m = clean.match(/^(.*\/node_modules\/)((?:@[^/]+\/)?[^/]+)\//);
+        if (!m) continue;
+        roots.set(m[2]!, m[1]! + m[2]!);
+      }
+      const names = [...roots.keys()].sort();
+      const parts: string[] = [
+        "Pip's Pots - open-source notices",
+        "================================",
+        "",
+        "Pip's Pots is built with the open-source packages below. Each is used under its own licence,",
+        "reproduced in full here.",
+        "",
+        "Packages: " + names.length,
+        "",
+      ];
+      for (const name of names) {
+        const dir = roots.get(name)!;
+        let version = "";
+        let licence = "see below";
+        try {
+          const pkg = JSON.parse(readFileSync(join(dir, "package.json"), "utf8"));
+          version = pkg.version ?? "";
+          licence = typeof pkg.license === "string" ? pkg.license : pkg.license?.type ?? licence;
+        } catch {
+          /* no package.json */
+        }
+        let text = "";
+        for (const d of [dir, dirname(dir)]) {
+          if (!existsSync(d)) continue;
+          const f = readdirSync(d).find((x) => /^(licen[cs]e|copying)(\.(md|txt))?$/i.test(x));
+          if (f) {
+            text = readFileSync(join(d, f), "utf8").trim();
+            break;
+          }
+        }
+        parts.push("-".repeat(78), `${name}${version ? " " + version : ""}  (${licence})`, "-".repeat(78), "", text || `Licensed under ${licence}.`, "");
+      }
+      this.emitFile({ type: "asset", fileName: "THIRD_PARTY_NOTICES.txt", source: parts.join("\n") });
+    },
+  };
+}
