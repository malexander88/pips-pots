+/** Where the wall notes can sit clear of the pick buttons and the piano (CSS px). */
+export function wallNotes(w: number, h: number) {
+  const vw = w / 100;
+  const vh = h / 100;
+  const pick = Math.max(54, Math.min(Math.min(19 * vh, 9 * vw), 96));
+  const toyW = Math.min(80 * vw, w - 140, (92 * vh - pick - 34) * 2.4, 1180);
+  const toyH = toyW / 2.4;
+  const rigTop = h - Math.max(10, 8 * vh) - toyH;
+  const rigLeft = (w - toyW) / 2;
+  const rigRight = rigLeft + toyW;
+  const picksBottom = 10 + pick;
+  const s = Math.max(22, Math.min(w, h) * 0.065);
+  // A note glyph spans about 1.1 s above its head centre and 0.3 s below.
+  const out: { x: number; y: number; s: number; fill: string }[] = [];
+  const band = rigTop - picksBottom;
+  if (band >= s * 1.9) {
+    const y = picksBottom + band * 0.5 + s * 0.4;
+    out.push({ x: rigLeft + toyW * 0.12, y, s, fill: "#ff9cc8" });
+    out.push({ x: rigRight - toyW * 0.14, y: y - s * 0.2, s: s * 0.9, fill: "#6fe0f2" });
+  } else if (w - rigRight >= s * 1.6) {
+    // Short screens: one note in the clear wall to the right of the piano (Pip has the left).
+    out.push({ x: rigRight + (w - rigRight) * 0.45, y: rigTop + s * 1.3, s: Math.min(s, (w - rigRight) * 0.5), fill: "#6fe0f2" });
+  }
+  return out;
+}
