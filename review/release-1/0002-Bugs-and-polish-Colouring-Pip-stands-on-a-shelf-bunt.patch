+/**
+ * release-1: the little wall shelf Pip stands on in the art room (Pip's feet meet its top at 45%
+ * of this canvas's height; see .colour-perch). Honey wood like the table, navy outline, two
+ * brackets, and a soft contact shadow where Pip stands.
+ */
+function paintShelfRaw(ctx: Ctx, w: number, h: number) {
+  const o = Math.max(2, w * 0.032);
+  const top = h * 0.45;
+  const bot = h * 0.72;
+  const x0 = w * 0.05;
+  const x1 = w * 0.95;
+  // Brackets first, so the plank overlaps them.
+  for (const bx of [0.24, 0.76]) {
+    ctx.beginPath();
+    ctx.moveTo(w * bx - w * 0.06, bot - o * 0.3);
+    ctx.lineTo(w * bx + w * 0.06, bot - o * 0.3);
+    ctx.lineTo(w * bx, h - o * 0.8);
+    ctx.closePath();
+    ctx.fillStyle = "#d98f45";
+    ctx.fill();
+    stroke(ctx, o);
+  }
+  ctx.beginPath();
+  ctx.roundRect(x0, top, x1 - x0, bot - top, (bot - top) * 0.35);
+  const g = ctx.createLinearGradient(0, top, 0, bot);
+  g.addColorStop(0, "#ffd08f");
+  g.addColorStop(0.45, "#f2b46a");
+  g.addColorStop(1, "#d98f45");
+  ctx.fillStyle = g;
+  ctx.fill();
+  stroke(ctx, o);
+  // Grain and a top highlight.
+  ctx.strokeStyle = "rgba(160, 90, 30, 0.35)";
+  ctx.lineWidth = Math.max(1, o * 0.45);
+  ctx.beginPath();
+  ctx.moveTo(x0 + w * 0.12, top + (bot - top) * 0.62);
+  ctx.lineTo(x0 + w * 0.36, top + (bot - top) * 0.62);
+  ctx.moveTo(x1 - w * 0.34, top + (bot - top) * 0.5);
+  ctx.lineTo(x1 - w * 0.12, top + (bot - top) * 0.5);
+  ctx.stroke();
+  ctx.strokeStyle = "rgba(255, 255, 255, 0.6)";
+  ctx.lineWidth = Math.max(1, o * 0.5);
+  ctx.beginPath();
+  ctx.moveTo(x0 + w * 0.08, top + o * 0.9);
+  ctx.lineTo(x1 - w * 0.08, top + o * 0.9);
+  ctx.stroke();
+  contact(ctx, w / 2, top + o * 0.4, w * 0.24, Math.max(2, (bot - top) * 0.28));
+}
+
+export const paintShelf = safePaint("colour-shelf", paintShelfRaw);
