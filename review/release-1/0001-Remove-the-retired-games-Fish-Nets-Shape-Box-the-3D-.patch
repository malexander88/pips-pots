-function poseDrop(sim: BoxSim, toy: BoxToy, ms: number) {
-  const hole = holeForToy(sim, toy);
-  if (!hole) return;
-  const align = 180;
-  const sink = 420;
-  const mouth = alongHole(hole, 0);
-  if (ms <= align) {
-    const u = easeOutBack(clamp01(ms / align));
-    toy.x = lerp(toy.fromX, mouth.x, u);
-    toy.y = lerp(toy.fromY, mouth.y + 0.34, u);
-    toy.z = lerp(toy.fromZ, mouth.z, u);
-    toy.rz = angLerp(toy.fromRz, 0, u);
-    toy.scale = 1.25 * 1.12;
-    toy.rx = 0;
-    if (FLAT_SHAPE[toy.shape]) toy.ry = 0;
-  } else if (ms <= sink) {
-    const u = clamp01((ms - align) / (sink - align));
-    const depth = u * 0.62;
-    const at = alongHole(hole, depth);
-    const scale = lerp(1.15, 0.78, u);
-    toy.scale = scale;
-    toy.x = at.x;
-    toy.z = at.z;
-    // Ball and block meshes are lifted inside the group so they sit in the tray.
-    const lift = (toy.shape === "ball" ? 0.192 : toy.shape === "block" ? 0.114 : 0.05) * scale;
-    toy.y = at.y - lift;
-    toy.rz = 0;
-    toy.rx = FLAT_SHAPE[toy.shape] ? 0 : u * 0.25;
-    if (FLAT_SHAPE[toy.shape]) toy.ry = 0;
-  } else {
-    const at = alongHole(hole, 0.9);
-    toy.x = at.x;
-    toy.y = at.y;
-    toy.z = at.z;
-    toy.scale = 0.001;
-  }
-  if (ms >= 180 && ms <= 480 && !sim.calmMotion) {
-    const u = clamp01((ms - 180) / 300);
-    sim.boxSquash = Math.sin(u * Math.PI);
-  }
-}
