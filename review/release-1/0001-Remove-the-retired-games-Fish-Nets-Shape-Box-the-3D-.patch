-/** Grab sphere used by the fish raycast. Keep in step with PlayFish. */
-export const FISH_HIT_R = 0.98;
-
-export type ScreenBox = {
-  left: number;
-  right: number;
-  top: number;
-  bottom: number;
-  slot: number;
-  phase: string;
-  cx: number;
-  cy: number;
-};
-
-type GrabFish = {
-  x: number;
-  y: number;
-  z: number;
-  scale: number;
-  slot: number;
-  phase: string;
-};
-
-type GrabSim = {
-  camera: unknown;
-  fish: GrabFish[];
-  project(x: number, y: number, z: number): { x: number; y: number };
-};
-
-/** Positive gap in CSS pixels. Negative means the boxes overlap. Corner gaps use the diagonal. */
-export function aabbGap(
-  a: { left: number; right: number; top: number; bottom: number },
-  b: { left: number; right: number; top: number; bottom: number },
-) {
-  const sepX = Math.max(b.left - a.right, a.left - b.right);
-  const sepY = Math.max(b.top - a.bottom, a.top - b.bottom);
-  if (sepX > 0 && sepY > 0) return Math.hypot(sepX, sepY);
-  return Math.max(sepX, sepY);
-}
-
-/** Viewport-space AABB of every fish that can still be grabbed. */
-export function fishGrabBoxes(sim: GrabSim): ScreenBox[] {
-  if (!sim.camera || typeof document === "undefined") return [];
-  const canvas = document.querySelector("canvas");
-  const origin = canvas?.getBoundingClientRect();
-  const ox = origin?.left ?? 0;
-  const oy = origin?.top ?? 0;
-  const boxes: ScreenBox[] = [];
-  for (const fish of sim.fish) {
-    if (fish.phase === "tunnel" || fish.phase === "exit") continue;
-    const radius = FISH_HIT_R * Math.max(0.05, fish.scale);
-    const center = sim.project(fish.x, fish.y, fish.z);
-    const edgeX = sim.project(fish.x + radius, fish.y, fish.z);
-    const edgeY = sim.project(fish.x, fish.y + radius, fish.z);
-    const rx = Math.max(12, Math.hypot(edgeX.x - center.x, edgeX.y - center.y));
-    const ry = Math.max(12, Math.hypot(edgeY.x - center.x, edgeY.y - center.y));
-    const cx = center.x + ox;
-    const cy = center.y + oy;
-    boxes.push({
-      left: cx - rx,
-      right: cx + rx,
-      top: cy - ry,
-      bottom: cy + ry,
-      slot: fish.slot,
-      phase: fish.phase,
-      cx,
-      cy,
-    });
-  }
