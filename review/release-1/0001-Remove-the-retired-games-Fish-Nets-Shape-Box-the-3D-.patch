-  }
-  return true;
-}
-
-/** True when this set is pairwise safe, or can still grow into a safe triple. */
-function canShow(colors: ColorId[], mode: PaletteMode) {
-  if (mode !== "cb") return true;
-  if (colors.length >= 3) return true;
