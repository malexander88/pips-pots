-  const clamped = Math.min(0.999, Math.max(0, u));
-  const point = curve.getPointAt(clamped);
-  const tangent = curve.getTangentAt(clamped);
-  fish.x = point.x;
-  fish.y = point.y;
-  fish.z = point.z;
-  fish.u = u;
-  fish.roll = roll;
