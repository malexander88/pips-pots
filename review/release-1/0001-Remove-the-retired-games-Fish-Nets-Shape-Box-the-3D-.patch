-    const last = pts[pts.length - 1];
-    if (!last || last.distanceToSquared(p) > 1e-10) pts.push(p);
-  }
-  if (pts.length > 1 && pts[0]!.distanceToSquared(pts[pts.length - 1]!) < 1e-10) pts.pop();
-  const n = pts.length;
-  if (n < 3) return pts.map((p) => p.clone());
-  const ccw = signedArea(pts) > 0 ? 1 : -1;
-  const out: THREE.Vector2[] = [];
-  for (let i = 0; i < n; i++) {
-    const prev = pts[(i - 1 + n) % n]!;
-    const cur = pts[i]!;
-    const next = pts[(i + 1) % n]!;
-    const e0 = new THREE.Vector2().subVectors(cur, prev).normalize();
-    const e1 = new THREE.Vector2().subVectors(next, cur).normalize();
