-import { RoundedBox } from "@react-three/drei";
-import { forwardRef, type ComponentProps } from "react";
-import type * as THREE from "three";
-
-/**
- * Theme cycle 7: drei's RoundedBox inverts and inflates when the corner radius is at least half the
- * smallest side (the pots board came out 0.891 tall instead of 0.46). Clamp the radius just below
- * half the smallest side so the box always has its real size. An ink hull built from the grown args
- * then clamps to body radius + ink thickness, so it never rises more than the ink above the body.
- */
-export function safeRadius(args: readonly number[], radius: number) {
-  const smallest = Math.min(...args.map((v) => Math.abs(v)));
-  return Math.max(0.001, Math.min(radius, 0.5 * smallest - 0.005));
-}
-
-type Props = ComponentProps<typeof RoundedBox>;
-
-export const SafeRoundedBox = forwardRef<THREE.Mesh, Props>(function SafeRoundedBox({ args, radius = 0.05, ...rest }, ref) {
-  const a = (args ?? [1, 1, 1]) as [number?, number?, number?];
-  const dims = [a[0] ?? 1, a[1] ?? 1, a[2] ?? 1];
-  return <RoundedBox ref={ref} args={args} radius={safeRadius(dims, radius)} {...rest} />;
-});
