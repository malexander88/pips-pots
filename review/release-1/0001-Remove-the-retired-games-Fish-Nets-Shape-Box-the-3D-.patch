-/**
- * Theme cycle 11b: hoops are back to their pre-c8 size (0.8, or smaller to keep 2.6 R between
- * rows, with an 80 px floor). Bigger fish no longer need a big hoop: it stretches around them.
- */
-function fitR(sim: FishSim, ys: number[]) {
-  let R = 0.8;
-  let minGap = Infinity;
-  for (let i = 1; i < ys.length; i++) minGap = Math.min(minGap, Math.abs(ys[i]! - ys[i - 1]!));
-  if (Number.isFinite(minGap) && minGap < 2.6 * R) R = minGap / 2.6;
-  const span = Math.max(0.4, sim.viewTop - sim.viewBottom);
-  const px = sim.screenH / span;
-  const floorR = 80 / Math.max(1, px);
-  if (R < floorR && minGap >= floorR * 2.6) R = floorR;
-  if (Number.isFinite(minGap) && R * 2.6 > minGap) R = minGap / 2.6;
-  return Math.max(0.34, R);
