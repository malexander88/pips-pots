-    droop: top ? 1 : bottom ? -1 : 0,
-    // Lean toward -X so a lower pole climbs left of the hoops above it.
-    // A +X lean runs through the tunnel that leaves to the right.
-    lean: top ? 0 : bottom ? (-34 * Math.PI) / 180 : (-28 * Math.PI) / 180,
