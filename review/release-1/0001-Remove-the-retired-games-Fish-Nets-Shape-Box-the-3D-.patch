-    _fullC[f++] = x - FISH_PAD;
-    _fullC[f++] = y;
-    _fullC[f++] = z;
-    _fullC[f++] = x + FISH_PAD;
-    _fullC[f++] = y;
-    _fullC[f++] = z;
-  }
-  return { full: _fullC.subarray(0, f), solve };
-}
