@@ -0,0 +1,84 @@
+import { vehicleWorldBox, zoom } from "./balloons/runtime";
+import { audio } from "./audio";
+import { sim } from "./sim";
+import { PIANO_VOICES, playKey, type PianoVoice } from "./piano/pianoSynth";
+
+/** Read once. URL flags apply only in dev or when ?test=1 is set. */
+export function applyBoot(): number | [number, number] {
+  if (typeof window === "undefined") return [1, 1.5];
+  const params = new URLSearchParams(window.location.search);
+  const testing = params.get("test") === "1";
+  const dev = import.meta.env.DEV || testing;
+  if (!dev) return [1, 1.5];
+
+  if (testing) {
+    sim.testMode = true;
+    sim.qualityLocked = true;
+  }
+  const seed = Number(params.get("seed"));
+  if (params.get("seed") && Number.isFinite(seed)) sim.setSeed(seed);
+  if (params.get("calm") === "1") sim.calm = true;
+  const quality = params.get("quality");
+  if (quality === "high" || quality === "medium" || quality === "low") {
+    sim.qualityTier = quality;
+    sim.qualityLocked = true;
+  }
+  if (params.get("freeze") === "1") sim.frozen = true;
+
+  const mode = params.get("mode");
+  const startMode: Record<string, () => void> = {
+    balloons: () => sim.startBalloons(),
+    bubbles: () => sim.startBubbles(),
+    sorting: () => sim.startSorting(),
+    piano: () => sim.startPiano(),
+    colouring: () => sim.startColouring(),
+  };
+  const pic = Number(params.get("pic"));
+  if (params.has("pic") && Number.isFinite(pic)) sim.colourPic = Math.max(0, Math.floor(pic));
+  const voice = params.get("voice");
+  if (voice && (PIANO_VOICES as string[]).includes(voice)) sim.pianoVoice = voice as PianoVoice;
+  if (mode && startMode[mode]) startMode[mode]!();
+
+  /** Review hook: render a voice playing notes [key, startSec] offline; returns mono samples. */
+  (window as unknown as { __pianoRender?: unknown }).__pianoRender = async (v: PianoVoice, notes: [number, number][], seconds: number, master = 1) => {
+    const ctx = new OfflineAudioContext(1, Math.ceil(44100 * seconds), 44100);
+    const bus = ctx.createGain();
+    bus.gain.value = master;
+    bus.connect(ctx.destination);
+    for (const [k, at] of notes) playKey(ctx, bus, v, k, at);
+    const buf = await ctx.startRendering();
+    return Array.from(buf.getChannelData(0));
+  };
+
+  window.__pipTest = {
+    ready: () =>
+      new Promise<void>((resolve) => {
+        const check = () => {
+          if (sim.frames >= 3) resolve();
+          else requestAnimationFrame(check);
+        };
+        check();
+      }),
+    audio: () => audio.stats(),
+    advance: (seconds) => sim.advance(seconds),
+    stats: () => ({
+      drawCalls: sim.drawCalls,
+      triangles: sim.triangles,
+      fps: Math.round(sim.fps),
+      tier: sim.qualityTier,
+    }),
+    zoomVehicle: () => {
+      const box = vehicleWorldBox(sim, sim.balloonScene);
+      return box ? sim.tapVehicle(box.x, box.y) : false;
+    },
+    zoomState: () => ({ ...zoom, sorted: sim.sorted }),
+    popBalloon: (id?: number) => {
+      const balloon = id != null ? sim.balloons.find((item) => item.id === id) : sim.balloons.find((item) => item.phase === "rise");
+      if (balloon) sim.popBalloon(balloon.id);
+    },
+  };
+
+  if (sim.qualityTier === "high") return 1.5;
+  if (sim.qualityTier === "low") return 1;
+  return [1, 1.5];
+}
