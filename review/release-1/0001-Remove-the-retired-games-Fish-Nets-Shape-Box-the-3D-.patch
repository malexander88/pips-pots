-function makeBalloonProfile() {
-  const R = 0.5;
-  const yTop = 0.54;
-  const height = 1.18;
-  const yBot = yTop - height;
-  const yEq = yTop - height * 0.4;
-  const lower = 0.52;
-  const neckR = 0.09;
-  const steps = 72;
-  const pts: THREE.Vector2[] = [];
-  for (let i = 0; i <= steps; i++) {
-    const t = i / steps;
-    const y = yTop - t * (yTop - yBot);
-    let r: number;
-    if (y >= yEq) {
-      const dy = (y - yEq) / (yTop - yEq);
-      r = R * Math.sqrt(Math.max(0, 1 - dy * dy));
-    } else {
-      const dy = (yEq - y) / lower;
-      if (dy <= 0.9) {
-        r = R * Math.sqrt(Math.max(0, 1 - dy * dy));
-      } else {
-        const u = Math.min(1, (dy - 0.9) / 0.35);
-        const s = u * u * (3 - 2 * u);
-        const join = R * Math.sqrt(Math.max(0, 1 - 0.9 * 0.9));
-        r = THREE.MathUtils.lerp(join, neckR, s);
-      }
-    }
-    pts.push(new THREE.Vector2(r, y));
-  }
-  pts[0] = new THREE.Vector2(0, yTop);
-  pts[pts.length - 1] = new THREE.Vector2(neckR, yBot);
-  return pts;
-}
