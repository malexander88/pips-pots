-  const cursor = speciesCursor.get(sim) ?? sim.seed % FISH_TYPE_COUNT;
-  for (let i = 0; i < FISH_TYPE_COUNT; i++) {
-    const pick = (cursor + i) % FISH_TYPE_COUNT;
-    if (!live.has(pick)) {
-      speciesCursor.set(sim, pick + 1);
-      return pick;
-    }
-  }
-  speciesCursor.set(sim, cursor + 1);
-  return cursor % FISH_TYPE_COUNT;
