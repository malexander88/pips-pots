-  if (sim.calmMotion) return;
-  const lid = lidCenter(sim.shapeHoleCount);
-  const body = bodyCenter(sim.shapeHoleCount);
-  const bits = sim.boxPile.splice(0, sim.boxPile.length);
-  const tray = traySlots(sim.shapeHoleCount);
-  const goal = tray[Math.floor(tray.length / 2)] ?? tray[0]!;
-  const count = Math.min(30, Math.max(bits.length, 8));
-  for (let i = 0; i < count; i++) {
-    const src = bits[i % Math.max(1, bits.length)];
-    const shape = src?.shape ?? sim.holes[i % sim.holes.length]!.shape;
-    const color = src?.color ?? FIXED_COLOR[shape];
-    const a = (i / count) * Math.PI * 2;
-    sim.boxFountain.push({
-      shape,
-      color,
-      x: lid.x + Math.cos(a) * 0.25,
-      y: body.y + 1.15,
-      z: lid.z + Math.sin(a) * 0.15,
-      rx: sim.rng() * 2,
-      ry: sim.rng() * 2,
-      rz: sim.rng() * 2,
-      vx: Math.cos(a) * (0.8 + (i % 3) * 0.25) + (goal.x - lid.x) * 0.35,
-      vy: 3.2 + (i % 4) * 0.25,
-      vz: Math.sin(a) * 0.45 + (goal.z - lid.z) * 0.15,
