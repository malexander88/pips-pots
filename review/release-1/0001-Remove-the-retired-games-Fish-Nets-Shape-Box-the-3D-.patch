-export type RingFrame = { inv: THREE.Matrix4; scale: number; bob: number; sway: number; groupPos: THREE.Vector3; pop: number };
-
-/** World → hoop-local (torus around local Z, rest radius 0.8). Mirrors NetField's hoop transform. */
-export function ringFrame(net: Net, index: number, time: number, calm: boolean): RingFrame {
-  const pose = hoopPose(time, index, calm, net.wobble);
-  const pop = Math.max(0.001, net.scale);
-  const hoopScale = (net.R / HOOP_R) * pose.squash;
-  const groupPos = new THREE.Vector3(net.x, net.y + net.sink, net.z);
-  _q.setFromEuler(_e.set(pose.wobble * 0.4, HOOP_YAW, pose.sway + pose.wobble));
-  _m.compose(_v.set(0, pose.bob, 0), _q, _s.setScalar(hoopScale));
-  const g = new THREE.Matrix4().compose(groupPos, new THREE.Quaternion(), new THREE.Vector3(pop, pop, pop));
-  const world = g.multiply(_m);
-  return { inv: _ringInv.copy(world).invert().clone(), scale: hoopScale * pop, bob: pose.bob, sway: pose.sway, groupPos, pop };
-}
