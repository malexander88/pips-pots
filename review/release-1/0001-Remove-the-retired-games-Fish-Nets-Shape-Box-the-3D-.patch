-import type { ColorId } from "../theme";
-
-/** Standard pairs. White is not used here — it washes out on the sand. */
-export const PALETTE_ORDER: ColorId[] = ["red", "blue", "yellow", "green", "purple", "orange", "pink"];
-
-/** Colour-blind set may still use white, and only with the dark outline swatches. */
-const CB_ORDER: ColorId[] = ["blue", "orange", "yellow", "green", "purple", "red", "pink", "white"];
-
-function paletteOrder(mode: PaletteMode): ColorId[] {
-  return mode === "cb" ? CB_ORDER : PALETTE_ORDER;
-}
-
-export type PaletteMode = "std" | "cb";
-
-export const STD_HEX: Record<ColorId, string> = {
-  red: "#ff3b30",
-  blue: "#1e6bff",
-  yellow: "#ffd000",
-  green: "#22c55e",
-  purple: "#9b51e0",
-  orange: "#ff8a00",
-  pink: "#ff5fa2",
-  white: "#f5f7fa",
-};
-
-/** Okabe–Ito, mapped onto the same eight ids. */
-export const CB_HEX: Record<ColorId, string> = {
-  blue: "#0072B2",
-  orange: "#E69F00",
-  yellow: "#F0E442",
-  purple: "#56B4E9",
-  red: "#D55E00",
-  green: "#009E73",
-  pink: "#1a1a2e",
-  white: "#f5f5f5",
-};
-
-const FORBIDDEN: [ColorId, ColorId][] = [
-  ["red", "orange"],
-  ["pink", "orange"],
-  ["pink", "red"],
-  ["pink", "purple"],
-  ["blue", "purple"],
-  ["yellow", "white"],
-];
-
-/** 0 plain, 1 stripes, 2 spots. Colour-blind mode weaves this into the fish and the net. */
-export function patternFor(id: ColorId): number {
-  if (id === "red" || id === "green") return 1;
-  if (id === "blue" || id === "orange" || id === "pink") return 2;
-  return 0;
-}
-
-export function paletteHex(id: ColorId, mode: PaletteMode): string {
-  return mode === "cb" ? CB_HEX[id] : STD_HEX[id];
-}
-
-type Lab = { L: number; a: number; b: number };
-
-function srgbChannel(hex: number) {
-  const c = hex / 255;
-  return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
-}
-
-function parseHex(hex: string) {
-  const h = hex.replace("#", "");
-  return {
-    r: srgbChannel(parseInt(h.slice(0, 2), 16)),
-    g: srgbChannel(parseInt(h.slice(2, 4), 16)),
-    b: srgbChannel(parseInt(h.slice(4, 6), 16)),
-  };
-}
-
-export function oklab(hex: string): Lab {
-  const { r, g, b } = parseHex(hex);
-  const l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b;
-  const m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b;
-  const s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b;
-  const l_ = Math.cbrt(l);
-  const m_ = Math.cbrt(m);
-  const s_ = Math.cbrt(s);
-  return {
-    L: 0.2104542553 * l_ + 0.793617785 * m_ - 0.0040720468 * s_,
-    a: 1.9779984951 * l_ - 2.428592205 * m_ + 0.4505937099 * s_,
-    b: 0.0259040371 * l_ + 0.7827717662 * m_ - 0.808675766 * s_,
-  };
-}
-
-/** Euclidean distance in OKLab. */
-export function okDistance(hexA: string, hexB: string) {
-  const A = oklab(hexA);
-  const B = oklab(hexB);
-  return Math.hypot(A.L - B.L, A.a - B.a, A.b - B.b);
-}
-
-export function okL(hex: string) {
-  return oklab(hex).L;
-}
-
-function srgb(hex: string) {
-  const h = hex.replace("#", "");
-  return {
-    r: parseInt(h.slice(0, 2), 16) / 255,
-    g: parseInt(h.slice(2, 4), 16) / 255,
-    b: parseInt(h.slice(4, 6), 16) / 255,
-  };
-}
-
-/** Hue in degrees. Grey returns 0. */
-export function hueDeg(hex: string) {
-  const { r, g, b } = srgb(hex);
-  const max = Math.max(r, g, b);
-  const min = Math.min(r, g, b);
-  const d = max - min;
-  if (d < 1e-5) return 0;
-  let h = 0;
-  if (max === r) h = ((g - b) / d) % 6;
-  else if (max === g) h = (b - r) / d + 2;
-  else h = (r - g) / d + 4;
-  return (h * 60 + 360) % 360;
-}
-
-/** Saturation as max−min in sRGB. Near-white and near-black stay under ~0.15. */
-export function chroma(hex: string) {
-  const { r, g, b } = srgb(hex);
-  return Math.max(r, g, b) - Math.min(r, g, b);
-}
-
-/** Smallest hue step around the wheel. */
-export function hueGap(hexA: string, hexB: string) {
-  const d = Math.abs(hueDeg(hexA) - hueDeg(hexB));
-  return Math.min(d, 360 - d);
-}
-
-function forbiddenWith(color: ColorId, onScreen: ColorId[]) {
-  return onScreen.some((other) => FORBIDDEN.some(([a, b]) => (a === color && b === other) || (b === color && a === other)));
-}
-
-function contrasts(color: ColorId, onScreen: ColorId[], mode: PaletteMode) {
