-  sim.holes = shapes.map((shape, slot) => ({
-    id: sim.nextId++,
-    shape,
-    slot,
-    x: centers[slot]!.x,
-    y: centers[slot]!.y,
-    z: centers[slot]!.z,
-    glow: 0,
-    wiggle: 0,
-    spawnT: 1,
-    uses: 0,
-    slide: "live" as const,
-    baseX: centers[slot]!.x,
-    open: 1,
-    zShift: 0,
-  }));
-  sim.boxToys = [];
-  sim.boxPile = [];
-  sim.boxFountain = [];
-  sim.boxDrops = 0;
-  sim.boxMixHits = 0;
-  sim.boxMissRow = 0;
-  sim.boxSquash = 0;
-  sim.boxLid = 0;
-  sim.boxMouth = 0;
-  sim.boxOh = 0;
-  sim.boxFlap = 0;
-  sim.boxSurprise = -1;
-  sim.boxDropColors = [];
-  sim.boxHintToy = -1;
-  sim.boxHintAt = 0;
