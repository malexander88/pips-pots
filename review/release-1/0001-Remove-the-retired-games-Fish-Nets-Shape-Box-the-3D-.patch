-  toy.phase = "gone";
-  toy.scale = 0.001;
-  sim.boxDrops += 1;
-  sim.boxMissRow = 0;
-  if (sim.autoFade) {
-    sim.boxMixHits += 1;
-    if (sim.boxMixHits >= 20) {
-      sim.boxMixHits = 0;
-      sim.shapeMix = Math.min(1, Math.round((sim.shapeMix + 0.1) * 10) / 10);
-    }
-  }
-  const surprise = sim.boxDrops % 8 === 0;
-  const rotate = sim.boxDrops % 3 === 0;
-  if (rotate) {
-    const target = mostUsed(sim);
-    if (!target || target.slot !== slot) spawnBoxToy(sim, slot);
-    if (target) rotateHole(sim, target.id);
-    // The slide takes longer than the time left in a 2s step after the drop
-    // lands. Spawn now so the next drop is not lost (pile stayed one short).
-    if (target?.slot === slot) spawnBoxToy(sim, slot);
-  } else {
-    spawnBoxToy(sim, slot);
-  }
-  if (surprise) startSurprise(sim);
-  sim.bump();
