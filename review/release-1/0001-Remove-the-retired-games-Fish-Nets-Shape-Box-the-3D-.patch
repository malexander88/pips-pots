-  const consider = (allowLast: boolean) => {
-    for (let step = 1; step <= n; step++) {
-      const idx = (start + step) % n;
-      const color = order[idx]!;
-      if (onScreen.includes(color)) continue;
-      if (!allowLast && lastInSlot && color === lastInSlot) continue;
-      if (!contrasts(color, onScreen, mode)) continue;
-      if (forbiddenWith(color, onScreen)) continue;
-      if (!canShow([...onScreen, color], mode)) continue;
-      return { color, cursor: idx };
-    }
-    return null;
-  };
-  const picked = consider(false) ?? consider(true);
-  if (picked) return picked;
-  let best = order[0]!;
-  let bestD = -1;
-  let bestIdx = 0;
-  for (let i = 0; i < n; i++) {
