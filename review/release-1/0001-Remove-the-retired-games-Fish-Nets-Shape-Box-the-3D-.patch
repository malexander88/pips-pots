-  fish.t = 0;
-  fish.fromX = fish.x;
-  fish.fromY = fish.y;
-  fish.crossed = false;
-  fish.grabable = false;
-  fish.useQuat = false;
-  fish.scale = 1;
-  fish.eye = 1;
-  fish.misses = 0;
-  fish.netId = net.id;
-  fish.z = 0.35;
-  fish.puffT = 0;
-  fish.sx = 1;
-  fish.sy = 1;
-  net.wobble = Math.max(net.wobble, 0.85);
