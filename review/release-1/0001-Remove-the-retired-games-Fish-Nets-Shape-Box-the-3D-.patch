-
-function screenDist(sim: FishSim, ax: number, ay: number, az: number, bx: number, by: number, bz: number) {
-  if (!sim.camera) return Math.hypot(ax - bx, ay - by) * 80;
-  const A = projectToScreen(sim.camera, ax, ay, az, sim.screenW, sim.screenH);
-  const B = projectToScreen(sim.camera, bx, by, bz, sim.screenW, sim.screenH);
