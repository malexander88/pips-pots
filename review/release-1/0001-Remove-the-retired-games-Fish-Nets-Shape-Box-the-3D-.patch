-function nearestHole(sim: BoxSim, sx: number, sy: number) {
-  let best: BoxHole | null = null;
-  let bestD = Infinity;
-  for (const hole of liveHoles(sim)) {
-    if (hole.slide !== "live") continue;
-    const p = sim.project(hole.x, hole.y, hole.z);
-    const d = Math.hypot(p.x - sx, p.y - sy);
-    if (d < bestD) {
-      best = hole;
-      bestD = d;
-    }
-  }
-  return best ? { hole: best, d: bestD, r: screenRadius(sim, best) } : null;
-}
