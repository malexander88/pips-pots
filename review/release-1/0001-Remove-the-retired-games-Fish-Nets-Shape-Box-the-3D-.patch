-// ---------------------------------------------------------------- ellipse fit
-
-/**
- * Smallest-ish ellipse (semi-axes a ≥ a0, b ≥ b0) holding every (p, q) point. Tries widening a in
- * steps and takes the one with the least added perimeter. Returns [a, b].
- */
-function fitEllipse(ps: number[], qs: number[], a0: number, b0: number): [number, number] {
-  if (!ps.length) return [a0, b0];
-  let maxP = 0;
-  for (const p of ps) maxP = Math.max(maxP, Math.abs(p));
-  let bestA = a0;
-  let bestB = Infinity;
-  let bestCost = Infinity;
-  const aMin = Math.max(a0, maxP * 1.0005);
-  for (let step = 0; step < 40; step++) {
-    const a = aMin * (1 + step * 0.04);
-    let b = b0;
-    for (let i = 0; i < ps.length; i++) {
-      const r = ps[i]! / a;
-      const den = 1 - r * r;
-      if (den <= 1e-4) {
-        b = Infinity;
-        break;
-      }
-      b = Math.max(b, Math.abs(qs[i]!) / Math.sqrt(den));
-    }
-    if (!Number.isFinite(b)) continue;
-    const cost = (a - a0) + (b - b0);
-    if (cost < bestCost) {
-      bestCost = cost;
-      bestA = a;
-      bestB = b;
-    }
-  }
-  if (!Number.isFinite(bestB)) return [a0 * MAX_K, b0 * MAX_K];
-  return [bestA, bestB];
-}
