-function springTo(k: number, v: number, target: number, dt: number) {
-  // Semi-implicit Euler with small substeps: stable, no jitter.
-  const steps = Math.max(1, Math.ceil(dt / (1 / 240)));
-  const h = dt / steps;
-  for (let i = 0; i < steps; i++) {
-    const a = -2 * ZETA * OMEGA * v - OMEGA * OMEGA * (k - target);
-    v += a * h;
-    k += v * h;
-  }
-  return [k, v] as const;
-}
