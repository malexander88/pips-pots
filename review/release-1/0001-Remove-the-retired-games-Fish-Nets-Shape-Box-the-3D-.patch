-function mostUsed(sim: BoxSim) {
-  const holes = sim.holes.filter((hole) => hole.slide === "live");
-  if (!holes.length) return null;
-  return holes.reduce((best, hole) => {
-    if (hole.uses > best.uses) return hole;
-    if (hole.uses === best.uses && hole.slot < best.slot) return hole;
-    return best;
-  });
-}
-
-export function rotateHole(sim: BoxSim, holeId: number) {
-  const hole = sim.holes.find((item) => item.id === holeId);
-  if (!hole || hole.slide !== "live") return;
-  // Every other hole on the lid, including ones still sliding out, so two round
-  // (or look-alike) holes are never on screen together, even mid-slide.
-  const others = sim.holes.filter((item) => item.id !== hole.id).map((item) => item.shape);
-  const picked = nextShape([...others, hole.shape], sim.shapeCursor);
-  sim.shapeCursor = picked.cursor;
-  if (shapesClash(picked.shape, hole.shape) || others.some((shape) => shapesClash(shape, picked.shape))) return;
-  hole.slide = "leave";
-  hole.spawnT = 0;
-  hole.open = 1;
-  hole.zShift = 0;
-  hole.x = hole.baseX;
-  const incoming: BoxHole = {
-    id: sim.nextId++,
-    shape: picked.shape,
-    slot: hole.slot,
-    x: hole.baseX,
-    y: hole.y,
-    z: hole.z,
-    glow: 0,
-    wiggle: 0,
-    spawnT: -1,
-    uses: 0,
-    slide: "enter",
-    baseX: hole.baseX,
-    open: 0,
-    zShift: 0,
-  };
-  sim.holes.push(incoming);
-  const old = sim.boxToys.find((toy) => toy.slot === hole.slot && toyAlive(toy) && toy.shape === hole.shape);
-  if (old && old.phase !== "drop") old.phase = "gone";
-  audio.slide();
-  sim.bump();
-}
