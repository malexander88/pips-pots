-    const n0 = new THREE.Vector2(e0.y, -e0.x).multiplyScalar(ccw);
-    const n1 = new THREE.Vector2(e1.y, -e1.x).multiplyScalar(ccw);
-    const bis = new THREE.Vector2().addVectors(n0, n1);
-    if (bis.lengthSq() < 1e-8) {
-      out.push(cur.clone().addScaledVector(n0, delta));
-      continue;
-    }
-    bis.normalize();
-    const cos = Math.max(1e-3, bis.dot(n0));
-    const len = Math.min(delta / cos, delta * miterLimit);
-    out.push(cur.clone().addScaledVector(bis, len));
-  }
-  // At a concave cusp (the top of a heart) neighbouring offset points cross over
-  // and make a small loop. Drop any offset point whose outgoing edge runs backwards
-  // relative to the source edge, until the loop is gone.
-  let keep = out.map((p, i) => ({ p, src: pts[i]! }));
-  for (let pass = 0; pass < 6 && keep.length > 3; pass++) {
-    const next = keep.filter((item, i) => {
-      const nxt = keep[(i + 1) % keep.length]!;
-      const prv = keep[(i - 1 + keep.length) % keep.length]!;
-      const dOut = new THREE.Vector2().subVectors(nxt.p, item.p);
-      const dSrc = new THREE.Vector2().subVectors(nxt.src, item.src);
-      const dOutPrev = new THREE.Vector2().subVectors(item.p, prv.p);
-      const dSrcPrev = new THREE.Vector2().subVectors(item.src, prv.src);
-      return dOut.dot(dSrc) >= 0 && dOutPrev.dot(dSrcPrev) >= 0;
