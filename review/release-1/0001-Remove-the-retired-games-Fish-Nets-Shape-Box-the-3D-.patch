-  audio.boxCheer(sim.boxDropColors, sim.calmMotion);
-  {
-    // Round-end house sparkle: one burst over each end of the lid.
-    const top = lidCenter(sim.shapeHoleCount);
-    const span = Math.abs(holeCenters(sim.shapeHoleCount)[0]!.x - top.x);
-    boxSuccessSparkle(sim.camera, top.x - span, top.y + 0.9, top.z, sim.calmMotion);
-    if (!sim.calmMotion) boxSuccessSparkle(sim.camera, top.x + span, top.y + 0.9, top.z, sim.calmMotion);
-    if (!sim.calmMotion) boxSuccessSparkle(sim.camera, top.x, top.y + 1.2, top.z, sim.calmMotion);
-    // Cycle 3: a bigger round-end moment. About 1 s of house stars drifting down (one at a time,
-    // 16 stars, 8 in calm) while the next box rolls in. No pause, no flashing.
-    boxRoundShower(sim.calmMotion);
