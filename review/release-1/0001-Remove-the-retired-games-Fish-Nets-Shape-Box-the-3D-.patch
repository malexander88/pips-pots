-  let f = 0;
-  for (let i = 0; i < n; i++) {
-    const x = out[i * 3]!;
-    const y = out[i * 3 + 1]!;
-    const z = out[i * 3 + 2]!;
-    for (let d = 0; d < FULL_RING; d++) {
