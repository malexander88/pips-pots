-function stepBlink(fish: Fish, dt: number, rng: () => number) {
-  const close = 0.07;
-  const hold = 0.04;
-  const open = 0.09;
-  const total = close + hold + open;
-  const amount = (u: number) => {
-    if (u < close) return u / close;
-    if (u < close + hold) return 1;
-    if (u < total) return 1 - (u - close - hold) / open;
-    return 0;
-  };
-  if (fish.blinkPhase >= 0) {
-    fish.blinkPhase += dt;
-    const t = fish.blinkPhase;
-    if (fish.doubleBlink > 0 && t >= total + 0.08) {
-      const u = t - total - 0.08;
-      fish.blink = amount(u);
-      if (u >= total) {
-        fish.blink = 0;
-        fish.blinkPhase = -1;
-        fish.doubleBlink = 0;
-        fish.blinkT = 3 + rng() * 3;
-      }
-      return;
-    }
-    if (t >= total) {
-      fish.blink = 0;
-      if (fish.doubleBlink > 0) return;
-      fish.blinkPhase = -1;
-      fish.blinkT = 3 + rng() * 3;
-      return;
-    }
-    fish.blink = amount(t);
-    return;
-  }
-  fish.blinkT -= dt;
-  if (fish.blinkT <= 0) {
-    fish.blinkPhase = 0;
-    fish.doubleBlink = rng() < 0.15 ? 1 : 0;
-  }
-}
