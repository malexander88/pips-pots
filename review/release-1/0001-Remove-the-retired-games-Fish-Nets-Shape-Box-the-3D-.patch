-/** Aligned rounds before fish and nets start to cross. */
-export const FISH_ALIGNED_CATCHES = 5;
-/** Never more than this many identical layouts in a row once crossing is on. */
-export const FISH_MAX_SAME_LAYOUT = 3;
-
-function identity(n: number) {
-  return Array.from({ length: n }, (_, i) => i);
-}
-
-function permKey(perm: number[]) {
-  return perm.join("");
-}
-
-/**
- * Pick the lane layout for the next round. Aligned for the first FISH_ALIGNED_CATCHES catches of
- * a session; then a fair random permutation (Fisher-Yates), rerolled only when it would be the
- * (FISH_MAX_SAME_LAYOUT + 1)th identical layout in a row.
- */
-export function chooseFishLayout(sim: FishSim) {
-  const n = sim.fishCount;
-  const prev = sim.fishPerm.length === n ? sim.fishPerm : identity(n);
-  let next: number[];
-  if (sim.fishStreak < FISH_ALIGNED_CATCHES) next = identity(n);
-  else {
-    const draw = () => {
-      const p = identity(n);
-      for (let i = n - 1; i > 0; i--) {
-        const j = Math.floor(sim.rng() * (i + 1));
-        const t = p[i]!;
-        p[i] = p[j]!;
-        p[j] = t;
-      }
-      return p;
-    };
-    next = draw();
-    if (permKey(next) === permKey(prev) && sim.fishPermRun >= FISH_MAX_SAME_LAYOUT) {
-      for (let tries = 0; tries < 16 && permKey(next) === permKey(prev); tries++) next = draw();
-    }
-  }
-  sim.fishPermRun = permKey(next) === permKey(prev) && sim.fishPerm.length === n ? sim.fishPermRun + 1 : 1;
-  sim.fishPerm = next;
-  return next;
-}
-
-function laneY(sim: FishSim, slot: number, ys: number[]) {
-  const row = sim.fishPerm.length === sim.fishCount ? sim.fishPerm[slot] ?? slot : slot;
-  return ys[row] ?? ys[slot] ?? ys[0]!;
-}
-
-/** Move every waiting fish to its lane for the current layout (a short swim, like a miss return). */
-function applyFishLayout(sim: FishSim) {
-  const ys = hoopYs(sim);
-  for (const fish of sim.fish) {
-    if (fish.phase === "exit" || fish.phase === "enterHoop" || fish.phase === "tunnel") continue;
-    const y = laneY(sim, fish.slot, ys);
-    if (Math.abs(fish.homeY - y) < 1e-3) continue;
-    fish.homeY = y;
-    if (fish.phase === "home" || fish.phase === "arrive") {
-      fish.opacity = 1;
-      fish.fromX = fish.x;
-      fish.fromY = fish.y;
-      fish.phase = "return";
-      fish.t = 0;
-      fish.turn = 0;
-      fish.useQuat = false;
-    }
-  }
-}
-
-function measure(sim: FishSim) {
-  const ys = hoopYs(sim);
-  const R = fitR(sim, ys);
-  const span = Math.max(0.4, sim.viewTop - sim.viewBottom);
-  sim.fishR = R;
-  sim.rScreen = (sim.screenH / span) * R;
-  // Whole fish, tail included, sits inside the left edge with margin.
-  // 1.45: the long cartoon tails (goldfish veil, shark) stay clear of the left edge.
-  sim.homeXFish = sim.viewLeft + 1.45 * FISH_LENGTH;
-  sim.netXFish = sim.viewRight - 3.1 * R - 1.2;
-  return { ys, R };
-}
-
-export function layoutFishRuntime(sim: FishSim, keep: boolean) {
-  ensurePool(sim);
-  const { ys, R } = measure(sim);
-  const n = sim.fishCount;
-  const usable = sim.pairs.filter((pair) => pair.phase !== "leaving");
-  if (!keep || usable.length !== n || sim.fish.length === 0) {
-    for (const net of sim.nets) {
-      net.active = false;
-      net.slot = -1;
-      net.opacity = 0;
-      net.scale = 0;
-    }
-    sim.pairs = [];
-    sim.fish = [];
-    let cursor = sim.seed % 8;
-    const chosen: ColorId[] = [];
-    chooseFishLayout(sim);
-    for (let slot = 0; slot < n; slot++) {
-      const pick = nextPairColour(chosen, null, cursor, sim.paletteMode);
-      cursor = pick.cursor;
-      chosen.push(pick.color);
-      const net = sim.nets[slot]!;
-      placeNet(net, slot, pick.color, netXFor(sim, slot), ys[slot]!, R, n, sim.paletteMode, netZFor(sim, slot));
-      const fish = makeFish(sim, pick.color, slot, net, laneY(sim, slot, ys), false);
-      sim.fish.push(fish);
-      sim.pairs.push({
-        slot,
-        color: pick.color,
-        phase: "live",
-        t: 0,
-        netId: net.id,
-        fishId: fish.id,
-        chimed: true,
-      });
-    }
-    sim.paletteCursor = cursor;
-    return;
-  }
-  for (const pair of sim.pairs) {
-    const net = netById(sim, pair.netId);
-    if (!net || pair.slot < 0 || pair.slot >= n) continue;
-    const style = styleFor(pair.slot, n);
-    net.x = netXFor(sim, pair.slot);
-    net.z = netZFor(sim, pair.slot);
-    net.y = ys[pair.slot]!;
-    net.R = R;
-    net.droop = style.droop;
-    net.lean = style.lean;
-    net.poleZ = style.poleZ;
-    net.curve = null;
-    const fish = fishById(sim, pair.fishId);
-    if (!fish) continue;
-    const dx = sim.homeXFish - fish.homeX;
-    fish.homeX = sim.homeXFish;
-    if (fish.phase === "home" || fish.phase === "arrive") fish.x += dx;
-    const lane = laneY(sim, fish.slot, ys);
