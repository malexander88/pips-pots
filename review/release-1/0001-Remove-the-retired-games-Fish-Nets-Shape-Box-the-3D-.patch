-  sim.boxPile.forEach((bit, index) => {
-    const goal = pileTarget(index);
-    const prevY = bit.y;
-    bit.x += (goal.x - bit.x) * k;
-    bit.y += (goal.y - bit.y) * k;
-    bit.z += (goal.z - bit.z) * k;
-    if (!bit.landed && prevY > goal.y + 0.04 && bit.y <= goal.y + 0.04) {
-      bit.landed = true;
