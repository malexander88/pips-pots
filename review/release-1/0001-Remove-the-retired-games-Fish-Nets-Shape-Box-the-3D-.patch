-/** Fish-local cloud → world, exactly as PlayFish draws it (shader roll, mesh scale, group TRS). */
-export function fishToWorld(fish: Fish, src: Float32Array, out: Float32Array) {
-  const type = FISH_TYPES[((fish.species % FISH_TYPES.length) + FISH_TYPES.length) % FISH_TYPES.length]!;
-  const size = PLAY_FISH_SCALE * type.size;
-  if (fish.useQuat) _q.set(fish.qx, fish.qy, fish.qz, fish.qw);
-  else _q.setFromEuler(_e.set(fish.wobble * 0.45, fish.rot, 0));
-  _s.set(Math.max(0.05, fish.scale * (fish.sx || 1)), Math.max(0.05, fish.scale * (fish.sy || 1)), Math.max(0.05, fish.scale));
-  _m.compose(_v.set(fish.x, fish.y, fish.z), _q, _s);
-  const roll = fish.useQuat ? 0 : fish.roll;
-  const cr = Math.cos(roll);
-  const sr = Math.sin(roll);
-  const e = _m.elements;
-  for (let i = 0; i < src.length; i += 3) {
-    const x = src[i]! * size;
-    const y0 = src[i + 1]!;
-    const z0 = src[i + 2]!;
-    const y = (y0 * cr - z0 * sr) * size;
-    const z = (y0 * sr + z0 * cr) * size;
-    out[i] = e[0]! * x + e[4]! * y + e[8]! * z + e[12]!;
-    out[i + 1] = e[1]! * x + e[5]! * y + e[9]! * z + e[13]!;
-    out[i + 2] = e[2]! * x + e[6]! * y + e[10]! * z + e[14]!;
-  }
-}
