-  let left = 6;
-  for (const bit of sim.sparks) {
-    if (left <= 0) break;
-    if (bit.life > 0) continue;
-    const a = (left / 6) * Math.PI * 2;
-    bit.life = 0.7;
-    bit.x = x + Math.cos(a) * 0.35;
-    bit.y = y + Math.sin(a) * 0.18;
-    bit.z = z;
-    bit.vx = Math.cos(a) * 0.6;
-    bit.vy = 1.1;
-    bit.vz = Math.sin(a) * 0.35;
-    bit.rx = 0;
-    bit.ry = 0;
-    bit.rz = 0;
-    bit.rvx = 0;
-    bit.rvy = 4;
-    bit.rvz = 0;
-    bit.s = 0.09;
-    bit.color = idx < 0 ? 2 : idx;
