-
-function spareNet(sim: FishSim) {
-  return sim.nets.find((net) => !net.active) ?? sim.nets[0]!;
-}
-
-function worldCurve(net: Net, exitX: number) {
-  const key = `${net.x.toFixed(2)}|${net.y.toFixed(2)}|${net.z.toFixed(2)}|${net.droop}|${exitX.toFixed(2)}`;
-  if (!net.curve || net.curveKey !== key) {
-    net.curve = makeNetCurve(new THREE.Vector3(net.x, net.y, net.z), exitX, net.droop);
-    net.curveKey = key;
-    net.curveLen = net.curve.getLength();
-  }
-  return net.curve;
-}
-
-function faceTangent(fish: Fish, tangent: THREE.Vector3, roll: number) {
-  _tan.copy(tangent);
-  if (_tan.lengthSq() < 1e-6) _tan.set(1, 0, 0);
-  _tan.normalize();
-  if (_tan.dot(_axis) < -0.999) _q.set(0, 1, 0, 0);
-  else _q.setFromUnitVectors(_axis, _tan);
-  // Roll around the fish's own length, after it is aimed along the tunnel.
-  // Negative so the pale belly faces the camera at 90°. The shader does not
-  // also roll, or the turn would double.
-  _rollQ.setFromAxisAngle(_axis, -roll);
-  _q.multiply(_rollQ);
-  fish.qx = _q.x;
-  fish.qy = _q.y;
-  fish.qz = _q.z;
-  fish.qw = _q.w;
-  fish.useQuat = true;
