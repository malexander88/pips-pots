-/** Fish pushing into this net right now: the matching fish being dragged into the mouth, then the pass. */
-export function enteringFish(sim: ElasticSim, net: Net) {
-  return sim.fish.filter(
-    (fish) =>
-      (fish.netId === net.id && (fish.phase === "enterHoop" || fish.phase === "tunnel")) ||
-      (fish.phase === "drag" && fish.color === net.color && net.active),
-  );
