-    const x = out[i * 3]!;
-    const y = out[i * 3 + 1]!;
-    const z = out[i * 3 + 2]!;
-    const b = Math.min(BINS - 1, Math.max(0, Math.floor(((x - x0) / span) * BINS)));
-    const base = b * (DIRS + 2);
-    for (let d = 0; d < DIRS; d++) {
-      const a = (d / DIRS) * Math.PI * 2;
-      const sv = y * Math.cos(a) + z * Math.sin(a);
-      if (sv > _bestS[base + d]!) {
-        _bestS[base + d] = sv;
-        _bestI[base + d] = i;
-      }
-    }
-    if (-x > _bestS[base + DIRS]!) {
-      _bestS[base + DIRS] = -x;
-      _bestI[base + DIRS] = i;
-    }
-    if (x > _bestS[base + DIRS + 1]!) {
-      _bestS[base + DIRS + 1] = x;
-      _bestI[base + DIRS + 1] = i;
-    }
-  }
-  if (_solve.length < BINS * (DIRS + 2) * 3) _solve = new Float32Array(BINS * (DIRS + 2) * 3);
-  let m = 0;
-  for (let b = 0; b < BINS; b++)
-    for (let d = 0; d < DIRS + 2; d++) {
-      const i = _bestI[b * (DIRS + 2) + d]!;
-      if (i < 0) continue;
-      let x = out[i * 3]!;
-      let y = out[i * 3 + 1]!;
-      let z = out[i * 3 + 2]!;
-      if (d < DIRS) {
-        const a = (d / DIRS) * Math.PI * 2;
-        // Pushed out a little past the pad so the polygon of directions still covers the circle.
-        y += Math.cos(a) * FISH_PAD * 1.02;
-        z += Math.sin(a) * FISH_PAD * 1.02;
-      } else x += (d === DIRS ? -1 : 1) * FISH_PAD;
-      _solve[m++] = x;
-      _solve[m++] = y;
-      _solve[m++] = z;
-    }
