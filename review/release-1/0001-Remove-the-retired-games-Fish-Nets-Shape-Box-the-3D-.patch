-import * as THREE from "three";
-
-/**
- * Theme cycle 7: keep resting toys ON their support. Returns the world-space lowest point of the
- * visible solid body meshes under `root` (ink hulls, contact shadows, hit spheres and other
- * transparent/back-side helpers are skipped). Every vertex is checked, so a tilted ball or block
- * reports its true lowest point rather than a rotated bounding-box corner. restOn caches the result
- * per pose, so a still toy costs nothing per frame.
- */
-const v = new THREE.Vector3();
-export function lowestPoint(root: THREE.Object3D) {
-  root.updateWorldMatrix(true, true);
-  let min = Infinity;
-  root.traverse((o) => {
-    const m = o as THREE.Mesh;
-    if (!m.isMesh || !m.visible) return;
-    const mat = m.material as THREE.Material;
-    if (!mat || Array.isArray(mat) || mat.side === THREE.BackSide || !mat.visible || mat.transparent) return;
-    const pos = m.geometry.getAttribute("position") as THREE.BufferAttribute | undefined;
-    if (!pos) return;
-    for (let i = 0; i < pos.count; i++) {
-      v.fromBufferAttribute(pos, i).applyMatrix4(m.matrixWorld);
-      if (v.y < min) min = v.y;
-    }
-  });
-  return min;
-}
-
-const cache = new WeakMap<THREE.Object3D, { key: string; lift: number }>();
-
-/** Lift `group` (world units) so its lowest body point is at least `floor`. Visual only. */
-export function restOn(group: THREE.Object3D, floor: number) {
-  const p = group.position;
-  const r = group.rotation;
-  const sc = group.scale;
-  // Visible-node count and child offsets/scales (idle bob, pickup spring) are part of the pose.
-  let n = 0;
-  group.traverse((o) => {
-    if (o.visible) n++;
-  });
-  for (const c of group.children) n += c.position.y * 1000 + c.scale.y * 7;
-  const key = [p.x, p.y, p.z, r.x, r.y, r.z, sc.x, sc.y, sc.z, floor, n].map((x) => x.toFixed(4)).join(",");
-  const hit = cache.get(group);
-  let lift = 0;
-  if (hit && hit.key === key) lift = hit.lift;
-  else {
-    const low = lowestPoint(group);
-    lift = Number.isFinite(low) && low < floor ? floor - low : 0;
-    cache.set(group, { key, lift });
-  }
-  if (lift > 0) {
-    group.position.y += lift;
-    group.updateMatrixWorld(true);
-  }
-}
