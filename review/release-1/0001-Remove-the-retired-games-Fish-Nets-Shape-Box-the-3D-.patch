-
-function applyMagnet(sim: FishSim, fish: Fish, dt: number) {
-  const magnet = magnetPx(sim, fish);
-  const correct = correctNet(sim, fish);
-  for (const net of sim.nets) {
-    if (!net.active) continue;
-    if (net !== correct) net.glow = 0;
-  }
-  if (!correct) return;
-  const d = screenDist(sim, fish.x, fish.y, fish.z, correct.x, correct.y, correct.z);
-  if (d < magnet) {
-    const closeness = 1 - d / magnet;
-    const dx = correct.x - fish.x;
-    const dy = correct.y - fish.y;
-    fish.x += dx * 0.25 * closeness * dt * 4;
