-export function pickColor(sim: BoxSim, shape: ShapeId, slot: number): ColorId {
-  const fixed = FIXED_COLOR[shape];
-  if (sim.rng() >= sim.shapeMix) return fixed;
-  const used = new Set(
-    sim.boxToys.filter((toy) => toyAlive(toy) && toy.slot !== slot).map((toy) => toy.color),
-  );
-  let pool = COLOR_IDS.filter((id) => !used.has(id));
-  if (pool.length === 0) pool = [...COLOR_IDS];
-  return pool[Math.floor(sim.rng() * pool.length)]!;
-}
