-function addPile(sim: BoxSim, toy: BoxToy) {
-  if (toy.piled) return;
-  toy.piled = true;
-  if (sim.boxPile.length >= 12) sim.boxPile.shift();
-  const index = sim.boxPile.length;
-  const goal = pileTarget(index);
-  sim.boxPile.push({
-    shape: toy.shape,
-    color: toy.color,
-    x: goal.x + (sim.rng() - 0.5) * 0.04,
-    y: 0.42,
-    z: goal.z,
-    rx: 0,
-    ry: 0,
-    rz: 0,
-    vx: 0,
-    vy: 0,
-    vz: 0,
-    landed: false,
-    world: false,
-    life: 1,
-  });
-}
-
-const LID_COS = Math.cos((25 * Math.PI) / 180);
-const LID_SIN = Math.sin((25 * Math.PI) / 180);
-
-/** World point on the tilted lid, `depth` units down the hole axis. */
-function alongHole(hole: BoxHole, depth: number) {
-  return {
-    x: hole.x,
-    y: hole.y + LID_COS * (0.12 - depth),
-    z: hole.z + LID_SIN * (0.12 - depth),
-  };
-}
