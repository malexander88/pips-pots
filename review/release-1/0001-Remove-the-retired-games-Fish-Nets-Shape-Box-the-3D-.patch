-import { useEffect } from "react";
-import * as Slider from "@radix-ui/react-slider";
-import { useLab, applySavedSettings, type ShapeKind } from "./store";
-
-function IconSphere() {
-  return (
-    <svg className="icon" viewBox="0 0 24 24" aria-hidden="true">
-      <circle cx="12" cy="12" r="7.25" fill="none" stroke="currentColor" strokeWidth="1.75" />
-      <ellipse cx="12" cy="12" rx="7.25" ry="2.75" fill="none" stroke="currentColor" strokeWidth="1.75" />
-    </svg>
-  );
-}
-
-function IconBox() {
-  return (
-    <svg className="icon" viewBox="0 0 24 24" aria-hidden="true">
-      <path
-        d="M12 3.5 19 7.25v9.5L12 20.5 5 16.75v-9.5L12 3.5Z"
-        fill="none"
-        stroke="currentColor"
-        strokeWidth="1.75"
-        strokeLinejoin="round"
-      />
-      <path d="M12 12.1 19 7.4M12 12.1 5 7.4M12 12.1v8.4" fill="none" stroke="currentColor" strokeWidth="1.75" strokeLinejoin="round" />
-    </svg>
-  );
-}
-
-function IconCylinder() {
-  return (
-    <svg className="icon" viewBox="0 0 24 24" aria-hidden="true">
-      <ellipse cx="12" cy="6.5" rx="6" ry="2.4" fill="none" stroke="currentColor" strokeWidth="1.75" />
-      <path d="M6 6.5v11c0 1.3 2.7 2.4 6 2.4s6-1.1 6-2.4v-11" fill="none" stroke="currentColor" strokeWidth="1.75" />
-    </svg>
-  );
-}
-
-const TOOLS: { kind: ShapeKind; label: string; icon: typeof IconSphere }[] = [
-  { kind: "sphere", label: "Sphere", icon: IconSphere },
-  { kind: "box", label: "Box", icon: IconBox },
-  { kind: "cylinder", label: "Cylinder", icon: IconCylinder },
-];
-
-function Field({
-  label,
-  value,
-  min,
-  max,
-  step,
-  onChange,
-}: {
-  label: string;
-  value: number;
-  min: number;
-  max: number;
-  step: number;
-  onChange: (value: number) => void;
-}) {
-  const digits = step < 0.1 ? 2 : 1;
-  return (
-    <label>
-      <span className="slider-label">
-        <span>{label}</span>
-        <span>{value.toFixed(digits)}</span>
-      </span>
-      <Slider.Root
-        className="slider"
-        min={min}
-        max={max}
-        step={step}
-        value={[value]}
-        onValueChange={([next]) => onChange(next ?? min)}
-        aria-label={label}
-      >
-        <Slider.Track className="slider-track">
-          <Slider.Range className="slider-range" />
-        </Slider.Track>
-        <Slider.Thumb className="slider-thumb" />
-      </Slider.Root>
-    </label>
-  );
-}
-
-export function Hud() {
-  const count = useLab((state) => state.bodies.length);
-  const gravity = useLab((state) => state.gravity);
-  const restitution = useLab((state) => state.restitution);
-  const spawn = useLab((state) => state.spawn);
-  const scatter = useLab((state) => state.scatter);
-  const clear = useLab((state) => state.clear);
-  const setGravity = useLab((state) => state.setGravity);
-  const setRestitution = useLab((state) => state.setRestitution);
-
-  useEffect(() => {
-    applySavedSettings();
-  }, []);
-
-  useEffect(() => {
-    const onKey = (event: KeyboardEvent) => {
-      if (event.repeat || event.metaKey || event.ctrlKey || event.altKey) return;
-      if (event.key === "1") spawn("sphere");
-      if (event.key === "2") spawn("box");
-      if (event.key === "3") spawn("cylinder");
-    };
-    window.addEventListener("keydown", onKey);
-    return () => window.removeEventListener("keydown", onKey);
-  }, [spawn]);
-
-  return (
-    <aside className="dock" aria-label="Physics tools">
-      <div className="dock-head">
-        <div>
-          <p className="eyebrow">Gravity bench</p>
-          <h1>Drop Lab</h1>
-        </div>
-        <p className="count" aria-live="polite">
-          {count} {count === 1 ? "body" : "bodies"}
-        </p>
-      </div>
-
-      <div className="tool-row">
-        {TOOLS.map((tool) => (
-          <button key={tool.kind} type="button" className="tool" onClick={() => spawn(tool.kind)}>
-            <tool.icon />
-            {tool.label}
-          </button>
-        ))}
-      </div>
-
-      <button type="button" className="wide" onClick={scatter}>
-        Drop a pile
-      </button>
-
-      <div className="sliders">
-        <Field label="Gravity" value={gravity} min={0} max={20} step={0.1} onChange={setGravity} />
-        <Field label="Bounce" value={restitution} min={0} max={0.9} step={0.01} onChange={setRestitution} />
-      </div>
-
-      <button type="button" className="clear" onClick={clear}>
-        Clear world
-      </button>
-
-      <p className="hint">Drag a shape to throw it. Drag empty space to look around.</p>
-      <p className="keys">1 sphere, 2 box, 3 cylinder</p>
-    </aside>
-  );
-}
