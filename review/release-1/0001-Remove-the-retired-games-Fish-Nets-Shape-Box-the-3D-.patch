-export function screenRadius(sim: BoxSim, hole: BoxHole) {
-  const c = sim.project(hole.x, hole.y, hole.z);
-  const e = sim.project(hole.x + HOLE_R, hole.y, hole.z);
-  return Math.max(24, Math.hypot(e.x - c.x, e.y - c.y));
