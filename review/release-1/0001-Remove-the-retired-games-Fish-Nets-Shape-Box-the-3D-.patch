-  const spot = traySlots(sim.shapeHoleCount)[slot];
-  if (!hole || !spot) return null;
-  sim.boxToys = sim.boxToys.filter((toy) => toy.slot !== slot || !toyAlive(toy));
-  const toy: BoxToy = {
-    id: sim.nextId++,
-    shape: hole.shape,
-    color: pickColor(sim, hole.shape, slot),
-    x: spot.x,
-    y: spot.y + (instant ? 0 : 0.35),
-    z: spot.z,
-    homeX: spot.x,
-    homeY: spot.y,
-    homeZ: spot.z,
-    phase: "rest",
-    t: instant ? 0.35 : 0,
-    vx: 0,
-    vy: 0,
-    misses: 0,
-    slot,
-    scale: instant ? 1.25 : 0.001,
-    rx: 0,
-    ry: hole.shape === "heart" || hole.shape === "star" || hole.shape === "pyramid" ? 0 : slot * 0.4,
-    rz: 0,
-    fromX: spot.x,
-    fromY: spot.y,
-    fromZ: spot.z,
-    fromRz: 0,
-    fingerX: spot.x,
-    fingerZ: spot.z,
