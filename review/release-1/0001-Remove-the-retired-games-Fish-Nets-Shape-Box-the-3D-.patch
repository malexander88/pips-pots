-    id: sim.nextId++,
-    color,
-    slot,
-    phase: arrive ? "arrive" : "home",
-    x: arrive ? sim.viewLeft - 0.8 : homeX,
-    y: homeY,
-    z: 0.35,
-    homeX,
-    homeY,
-    scale: 1,
-    sx: 1,
-    sy: 1,
-    rot: 0,
-    roll: 0,
-    wobble: 0,
-    tail: sim.rng() * Math.PI * 2,
-    t: 0,
-    u: 0,
-    fromX: sim.viewLeft - 0.8,
-    fromY: homeY,
-    misses: 0,
-    grabable: !arrive,
-    opacity: arrive ? 0.85 : 1,
-    netId: net.id,
-    species: pickSpecies(sim),
-    pattern: sim.paletteMode === "cb" ? patternFor(color) : 0,
-    qx: 0,
-    qy: 0,
-    qz: 0,
-    qw: 1,
-    useQuat: false,
-    crossed: false,
-    puffT: 0,
-    blink: 0,
-    blinkT: 3.2 + sim.rng() * 2.6,
