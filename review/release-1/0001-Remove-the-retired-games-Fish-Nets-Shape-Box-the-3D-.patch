-function ensureFrames(e: NetElastic, net: Net, exitX: number) {
-  const key = `${(exitX - net.x).toFixed(2)}|${net.droop}`;
-  if (e.curveKey === key && e.pts.length) return;
-  e.curveKey = key;
-  const curve = makeNetCurve(new THREE.Vector3(0, 0, 0), exitX - net.x, net.droop);
-  e.pts = [];
-  e.tans = [];
-  e.ups = [];
-  e.sides = [];
-  for (let i = 0; i < NS; i++) {
-    const u = i / BAG_SAMPLES;
-    const p = curve.getPointAt(u);
-    const t = curve.getTangentAt(u).normalize();
-    const up = bagUp(t, new THREE.Vector3());
-    e.pts.push(p);
-    e.tans.push(t);
-    e.ups.push(up);
-    e.sides.push(new THREE.Vector3().crossVectors(t, up).normalize());
-  }
-}
