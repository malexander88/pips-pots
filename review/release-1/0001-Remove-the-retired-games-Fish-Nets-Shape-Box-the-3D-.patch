-export function tunnelRoll(u: number) {
-  const start = 0.22;
-  const end = 0.74;
-  if (u < start || u > end) return 0;
-  const k = (u - start) / (end - start);
-  return Math.sin(k * Math.PI * 4) * 0.21 * Math.sin(k * Math.PI);
