-const DIRS = 16;
-const BINS = 40;
-const _bestS = new Float32Array(BINS * (DIRS + 2));
-const _bestI = new Int32Array(BINS * (DIRS + 2));
-let _solve = new Float32Array(0);
-let _fullC = new Float32Array(0);
-const FULL_RING = 8;
