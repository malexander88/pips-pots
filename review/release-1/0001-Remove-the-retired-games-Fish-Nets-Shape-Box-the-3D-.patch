-export function releaseBoxToy(sim: BoxSim, id: number, sx: number, sy: number) {
-  const toy = sim.boxToys.find((item) => item.id === id);
-  if (!toy || toy.phase !== "drag") return;
-  const match = holeForToy(sim, toy);
-  const near = nearestHole(sim, sx, sy);
-  if (match && near && near.hole.id === match.id && near.d <= near.r * 1.6) {
-    beginDrop(sim, toy, match);
-    return;
-  }
-  if (near && match && near.hole.id !== match.id && near.d <= near.r * 1.6) {
-    beginWrong(sim, toy, near.hole);
-    return;
-  }
-  beginReturn(sim, toy, 0.5, false);
