-function roundRectPath(path: THREE.Path, w: number, d: number, r: number, cw: boolean) {
-  const x = w / 2;
-  const y = d / 2;
-  const pts: [number, number, number][] = [
-    [x - r, y - r, 0],
-    [-x + r, y - r, Math.PI / 2],
-    [-x + r, -y + r, Math.PI],
-    [x - r, -y + r, (3 * Math.PI) / 2],
-  ];
-  const list = cw ? [...pts].reverse() : pts;
-  list.forEach(([cx, cy, a0], i) => {
-    if (cw) path.absarc(cx, cy, r, a0 + Math.PI / 2, a0, true);
-    else path.absarc(cx, cy, r, a0, a0 + Math.PI / 2, false);
-    void i;
-  });
-  path.closePath();
-}
