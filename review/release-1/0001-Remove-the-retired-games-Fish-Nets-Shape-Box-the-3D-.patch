-function holeSquare(r: number) {
-  const s = new THREE.Shape();
-  const a = r * 0.78;
-  const rad = r * 0.28;
-  s.moveTo(-a + rad, -a);
-  s.lineTo(a - rad, -a);
-  s.quadraticCurveTo(a, -a, a, -a + rad);
-  s.lineTo(a, a - rad);
-  s.quadraticCurveTo(a, a, a - rad, a);
-  s.lineTo(-a + rad, a);
-  s.quadraticCurveTo(-a, a, -a, a - rad);
-  s.lineTo(-a, -a + rad);
-  s.quadraticCurveTo(-a, -a, -a + rad, -a);
-  return s;
-}
