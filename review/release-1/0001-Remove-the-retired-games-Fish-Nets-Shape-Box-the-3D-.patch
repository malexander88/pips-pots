-/**
- * Three toys per row inside the upright glass. PILE_SPACING is the world
- * diameter at scale 0.4 plus a 0.09 gap, so neighbours stay ≥ 0.08 apart.
- * Newer rows sit higher and slightly closer to the glass.
- */
-function pileTarget(index: number) {
-  const cols = 3;
-  const col = index % cols;
-  const row = Math.floor(index / cols);
-  const x = (col - 1) * PILE_SPACING;
-  const y = -PILE_SPACING * 0.5 + row * PILE_SPACING;
-  const z = -0.17 + row * 0.02 + col * 0.004;
-  return { x, y, z };
-}
