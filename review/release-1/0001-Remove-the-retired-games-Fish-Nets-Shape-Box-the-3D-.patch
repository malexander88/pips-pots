-/**
- * Fish-local (pre mesh-scale) silhouette of this fish right now, padded by the outline.
- * `solve`: per x-slice extremes in 16 directions (what the fit needs), pushed out by the pad.
- * `full`: every vertex with a ring of padded copies (for the clip check).
- */
-export function fishCloud(fish: Fish, wantFull = false): Cloud {
