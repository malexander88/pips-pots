+import { memo, useEffect, useMemo, useRef, useState } from "react";
+import { audio } from "../audio";
+import { sim } from "../sim";
+import { HouseCanvas } from "../house/HouseCanvas";
+import { JAR_CAP, STAR_TINTS, paintJar, paintLedge, paintSky, paintSleepyPip, paintStarBody, paintTinyStar, paintTrail } from "./starArt";
+import "./stars.css";
+
+/**
+ * Shooting Star Catcher (replaces the bubble tubes). A flat 2D DOM stage, like the piano:
+ * the sky is painted once, each star is a pre-painted sprite moved with a compositor transform,
+ * and taps are read straight from pointerdown. No text, no fail state: missed stars drift off.
+ */
+const POOL = 6;
+const TINT_OF = Array.from({ length: POOL }, (_, i) => i % STAR_TINTS.length);
+const BODY_ART = TINT_OF.map((t) => paintStarBody(t));
+const TRAIL_ART = TINT_OF.map((t) => paintTrail(t));
+const TINY_ART = STAR_TINTS.map((_, t) => paintTinyStar(t));
+const JAR_ART = Array.from({ length: JAR_CAP + 1 }, (_, n) => paintJar(n));
+const PIP_CALM = paintSleepyPip(0);
+const PIP_CHEER = paintSleepyPip(0.6);
+
+type StarState = "off" | "drift" | "caught" | "fly";
+interface Star {
+  i: number;
+  el: HTMLElement;
+  state: StarState;
+  x: number;
+  y: number;
+  y0: number;
+  vx: number;
+  vy: number;
+  bobA: number;
+  bobW: number;
+  bobP: number;
+  t: number;
+  /** caught/fly timers and bezier points */
+  k: number;
+  fx: number;
+  fy: number;
+  cx: number;
+  cy: number;
+  scale: number;
+}
+
+/** The jar keeps its own state so a catch repaints only the jar, not the whole stage. */
+const JarArt = memo(function JarArt({ setRef }: { setRef: { current: ((n: number) => void) | null } }) {
+  const [count, setCount] = useState(0);
+  useEffect(() => {
+    setRef.current = setCount;
+    return () => {
+      setRef.current = null;
+    };
+  }, [setRef]);
+  return <HouseCanvas className="ss-jar-art" paint={JAR_ART[Math.min(JAR_CAP, count)]!} />;
+});
+
+const CATCH_HOLD = 0.75;
+const FLY_TIME = 2.3;
+const FULL_HOLD = 3.6;
+const EMPTY_STEP = 0.5;
+
+function StarCatcherInner() {
+  const stageRef = useRef<HTMLDivElement>(null);
+  const starsRef = useRef<HTMLDivElement>(null);
+  const cornerRef = useRef<HTMLDivElement>(null);
+  const jarRef = useRef<HTMLDivElement>(null);
+  const glowRef = useRef<HTMLDivElement>(null);
+  const pipRef = useRef<HTMLDivElement>(null);
+  const jarSet = useRef<((n: number) => void) | null>(null);
+  const twinkles = useMemo(() => {
+    let s = 3;
+    const r = () => ((s = (s * 16807) % 2147483647) / 2147483647);
+    return Array.from({ length: 26 }, () => ({
+      left: `${(r() * 100).toFixed(2)}%`,
+      top: `${(Math.pow(r(), 1.3) * 78).toFixed(2)}%`,
+      size: 2 + r() * 2.6,
+      dur: 3.5 + r() * 4.5,
+      delay: -r() * 8,
+    }));
+  }, []);
+
+  useEffect(() => {
+    const stage = stageRef.current;
+    const layer = starsRef.current;
+    const corner = cornerRef.current;
+    const jar = jarRef.current;
+    const glow = glowRef.current;
+    const pip = pipRef.current;
+    if (!stage || !layer || !corner || !jar || !glow || !pip) return;
+    const els = Array.from(layer.querySelectorAll<HTMLElement>(".ss-star"));
+    const stars: Star[] = els.map((el, i) => ({
+      i, el, state: "off", x: 0, y: 0, y0: 0, vx: 0, vy: 0, bobA: 0, bobW: 0, bobP: 0, t: 0, k: 0, fx: 0, fy: 0, cx: 0, cy: 0, scale: 1,
+    }));
+    let W = 1;
+    let H = 1;
+    let R = 40;
+    let mouth = { x: 0, y: 0 };
+    let jarCount = 0;
+    let pending = 0;
+    let mode: "play" | "full" | "empty" = "play";
+    let modeT = 0;
+    let emptyAcc = 0;
+    let chimeStep = 0;
+    let outStep = 0;
+    let nextSpawn = 0.4;
+    let paused = false;
+    let time = 0;
+    let raf = 0;
+    let last = performance.now();
+    let caughtTotal = 0;
+
+    const layout = () => {
+      const r = stage.getBoundingClientRect();
+      W = Math.max(1, r.width);
+      H = Math.max(1, r.height);
+      R = Math.max(28, Math.min(64, H * 0.085, W * 0.06));
+      const S = R / 0.26;
+      stage.style.setProperty("--ss-s", `${S}px`);
+      stage.style.setProperty("--ss-r", `${R}px`);
+      // Corner group: ledge, jar and Pip in the bottom-right, kept small.
+      const ledgeW = Math.min(W * 0.3, H * 0.7);
+      const ledgeH = ledgeW * 0.42;
+      const jarH = H * 0.2;
+      const jarW = jarH * 0.74;
+      const pipH = H * 0.16;
+      const pipW = pipH * 0.83;
+      corner.style.width = `${ledgeW}px`;
+      corner.style.height = `${ledgeH}px`;
+      const surfaceJar = ledgeH * 0.22;
+      const surfacePip = ledgeH * 0.3;
+      const jarLeft = ledgeW * 0.6 - jarW / 2;
+      const jarTop = surfaceJar - jarH + jarH * 0.03;
+      jar.style.cssText = `left:${jarLeft}px;top:${jarTop}px;width:${jarW}px;height:${jarH}px`;
+      glow.style.cssText = `left:${jarLeft - jarW * 0.9}px;top:${jarTop - jarH * 0.25}px;width:${jarW * 2.8}px;height:${jarH * 1.6}px`;
+      pip.style.cssText = `left:${ledgeW * 0.25 - pipW / 2}px;top:${surfacePip - pipH * 0.96}px;width:${pipW}px;height:${pipH}px`;
+      const cr = corner.getBoundingClientRect();
+      mouth = { x: cr.left - r.left + jarLeft + jarW / 2, y: cr.top - r.top + jarTop + jarH * 0.12 };
+    };
+    layout();
+    const ro = typeof ResizeObserver !== "undefined" ? new ResizeObserver(layout) : null;
+    ro?.observe(stage);
+
+    const place = (s: Star) => {
+      const S = R / 0.26;
+      s.el.style.transform = `translate3d(${s.x - S / 2}px, ${s.y - S / 2}px, 0) scale(${s.scale})`;
+    };
+
+    const spawn = (atX?: number) => {
+      const s = stars.find((q) => q.state === "off");
+      if (!s) return;
+      const calm = sim.calmMotion;
+      const ltr = Math.random() < 0.7;
+      const speed = 34 * (H / 390) * (0.8 + Math.random() * 0.45) * (calm ? 0.6 : 1);
+      const ang = (6 + Math.random() * 12) * (Math.PI / 180);
+      s.vx = Math.cos(ang) * speed * (ltr ? 1 : -1);
+      s.vy = Math.sin(ang) * speed;
+      // Pick a starting height clear of the other drifting stars.
+      let y0 = H * 0.3;
+      for (let tries = 0; tries < 8; tries++) {
+        y0 = H * (0.12 + Math.random() * 0.4);
+        if (stars.every((q) => q === s || q.state !== "drift" || Math.abs(q.y - y0) > H * 0.2)) break;
+      }
+      const S = R / 0.26;
+      s.x = atX ?? (ltr ? -S * 0.5 : W + S * 0.5);
+      s.y0 = y0;
+      s.y = y0;
+      s.bobA = sim.reduceMotion ? 0 : R * (0.12 + Math.random() * 0.12);
+      s.bobW = 0.5 + Math.random() * 0.3;
+      s.bobP = Math.random() * Math.PI * 2;
+      s.t = 0;
+      s.scale = 0.85 + Math.random() * 0.25;
+      s.state = "drift";
+      s.el.classList.remove("is-caught", "is-flying");
+      s.el.classList.add("is-on");
+      const trail = s.el.querySelector<HTMLElement>(".ss-trail");
+      if (trail) trail.style.transform = `rotate(${Math.atan2(s.vy, s.vx)}rad)`;
+      place(s);
+    };
+
+    const ring = (x: number, y: number, tint: number) => {
+      const el = document.createElement("i");
+      el.className = "ss-ring";
+      el.style.left = `${x}px`;
+      el.style.top = `${y}px`;
+      el.style.setProperty("--ring", STAR_TINTS[tint]!.light);
+      stage.appendChild(el);
+      window.setTimeout(() => el.remove(), 1700);
+    };
+
+    const floatOut = () => {
+      const el = document.createElement("i");
+      el.className = "ss-out";
+      el.style.left = `${mouth.x}px`;
+      el.style.top = `${mouth.y}px`;
+      el.style.setProperty("--dx", `${(Math.random() - 0.65) * H * 0.25}px`);
+      el.style.setProperty("--dy", `${-H * (0.3 + Math.random() * 0.15)}px`);
+      const c = document.createElement("canvas");
+      const px = Math.round(R * 0.7);
+      const dpr = Math.min(3, window.devicePixelRatio || 1);
+      c.width = Math.round(px * dpr);
+      c.height = Math.round(px * dpr);
+      c.style.width = c.style.height = `${px}px`;
+      const ctx = c.getContext("2d");
+      if (ctx) {
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        TINY_ART[outStep % TINY_ART.length]!(ctx, px, px);
+      }
+      el.appendChild(c);
+      stage.appendChild(el);
+      window.setTimeout(() => el.remove(), 3200);
+    };
+
+    const setJar = (n: number) => {
+      jarCount = n;
+      jarSet.current?.(n);
+      stage.dataset.jar = String(n);
+      glow.style.setProperty("--fill", String(n / JAR_CAP));
+    };
+
+    const arrive = () => {
+      if (mode !== "play") {
+        pending += 1;
+        return;
+      }
+      setJar(Math.min(JAR_CAP, jarCount + 1));
+      audio.starIn();
+      jar.animate([{ transform: "scale(1, 1)" }, { transform: "scale(1.04, 0.97)" }, { transform: "scale(1, 1)" }], { duration: 520, easing: "ease-out" });
+      if (jarCount >= JAR_CAP) {
+        mode = "full";
+        modeT = 0;
+        glow.classList.add("is-full");
+        pip.classList.add("is-cheer");
+        audio.starFull();
+      }
+    };
+
+    const catchStar = (s: Star) => {
+      if (s.state !== "drift") return;
+      s.state = "caught";
+      s.k = 0;
+      s.el.classList.add("is-caught");
+      ring(s.x, s.y, TINT_OF[s.i]!);
+      audio.starChime(chimeStep++);
+      caughtTotal += 1;
+      sim.touch();
+      nextSpawn = Math.min(nextSpawn, time + 2.5 + Math.random() * 1.5);
+    };
+
+    const onDown = (e: PointerEvent) => {
+      if (sim.grownUp) return;
+      if (e.pointerType === "mouse" && e.button !== 0) return;
+      audio.unlock();
+      const r = stage.getBoundingClientRect();
+      const x = e.clientX - r.left;
+      const y = e.clientY - r.top;
+      let best: Star | null = null;
+      let bestD = Math.max(R * 1.7, 56);
+      for (const s of stars) {
+        if (s.state !== "drift") continue;
+        const d = Math.hypot(s.x - x, s.y - y);
+        if (d < bestD) {
+          best = s;
+          bestD = d;
+        }
+      }
+      if (best) {
+        e.preventDefault();
+        catchStar(best);
+      }
+    };
+    stage.addEventListener("pointerdown", onDown, { passive: false });
+
+    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
+
+    const step = (dt: number) => {
+      time += dt;
+      const S = R / 0.26;
+      let drifting = 0;
+      for (const s of stars) {
+        if (s.state === "drift") {
+          s.t += dt;
+          s.x += s.vx * dt;
+          s.y0 += s.vy * dt;
+          s.y = s.y0 + Math.sin(s.t * s.bobW + s.bobP) * s.bobA;
+          if (s.x < -S || s.x > W + S || s.y > H + S) {
+            s.state = "off";
+            s.el.classList.remove("is-on");
+          } else {
+            drifting += 1;
+            place(s);
+          }
+        } else if (s.state === "caught") {
+          s.k += dt;
+          if (s.k >= CATCH_HOLD) {
+            s.state = "fly";
+            s.k = 0;
+            s.fx = s.x;
+            s.fy = s.y;
+            s.cx = (s.x + mouth.x) / 2 + (mouth.x > s.x ? -1 : 1) * W * 0.05;
+            s.cy = Math.min(s.y, mouth.y) - H * 0.18;
+            s.el.classList.add("is-flying");
+          }
+        } else if (s.state === "fly") {
+          s.k += dt;
+          const u = Math.min(1, s.k / FLY_TIME);
+          const e = ease(u);
+          const a = (1 - e) * (1 - e);
+          const b = 2 * (1 - e) * e;
+          const c = e * e;
+          s.x = a * s.fx + b * s.cx + c * mouth.x;
+          s.y = a * s.fy + b * s.cy + c * mouth.y;
+          s.scale = 1 - 0.8 * e;
+          place(s);
+          if (u >= 1) {
+            s.state = "off";
+            s.scale = 1;
+            s.el.classList.remove("is-on", "is-caught", "is-flying");
+            arrive();
+          }
+        }
+      }
+      if (mode === "full") {
+        modeT += dt;
+        if (modeT >= FULL_HOLD) {
+          mode = "empty";
+          modeT = 0;
+          emptyAcc = 0;
+          glow.classList.remove("is-full");
+          pip.classList.remove("is-cheer");
+        }
+      } else if (mode === "empty") {
+        emptyAcc += dt;
+        if (emptyAcc >= EMPTY_STEP && jarCount > 0) {
+          emptyAcc = 0;
+          setJar(jarCount - 1);
+          floatOut();
+          audio.starOut(outStep++);
+        }
+        if (jarCount === 0 && emptyAcc >= EMPTY_STEP) {
+          mode = "play";
+          const add = Math.min(JAR_CAP - 1, pending);
+          pending = 0;
+          if (add) setJar(add);
+        }
+      }
+      // Keep drifting stars politely apart: a soft vertical nudge when two get close.
+      for (let a = 0; a < stars.length; a++) {
+        const p = stars[a]!;
+        if (p.state !== "drift") continue;
+        for (let b = a + 1; b < stars.length; b++) {
+          const q = stars[b]!;
+          if (q.state !== "drift") continue;
+          const dx = q.x - p.x;
+          const dy = q.y - p.y;
+          const gap = R * 3.8;
+          const d = Math.hypot(dx, dy);
+          if (d < gap) {
+            const push = (gap - d) * 2.4 * dt * (dy >= 0 ? 1 : -1);
+            p.y0 = Math.max(H * 0.08, p.y0 - push);
+            q.y0 = Math.min(H * 0.7, q.y0 + push);
+          }
+        }
+      }
+      const want = W < H ? 2 : 3;
+      if (drifting < want && time >= nextSpawn) {
+        spawn();
+        nextSpawn = time + 3 + Math.random() * 2.5;
+      }
+    };
+
+    // Open with two stars already in the sky so the first look is never empty.
+    spawn(W * 0.22);
+    spawn(W * 0.56);
+    nextSpawn = 2.5;
+
+    const frame = (now: number) => {
+      const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));
+      last = now;
+      if (!paused && !document.hidden) step(dt);
+      raf = requestAnimationFrame(frame);
+    };
+    raf = requestAnimationFrame(frame);
+
+    const w = window as unknown as { __starTest?: unknown };
+    w.__starTest = {
+      stars: () => stars.map((s) => ({ i: s.i, state: s.state, x: s.x, y: s.y, tint: TINT_OF[s.i] })),
+      tapStar: (i?: number) => {
+        const s = i == null ? stars.find((q) => q.state === "drift") : stars[i];
+        if (!s || s.state !== "drift") return false;
+        const r = stage.getBoundingClientRect();
+        return { x: r.left + s.x, y: r.top + s.y };
+      },
+      catch: (i?: number) => {
+        const s = i == null ? stars.find((q) => q.state === "drift") : stars[i];
+        if (s) catchStar(s);
+        return !!s;
+      },
+      setJar: (n: number) => setJar(Math.max(0, Math.min(JAR_CAP, n))),
+      jar: () => ({ count: jarCount, mode, pending, caughtTotal }),
+      pause: (p: boolean) => {
+        paused = p;
+      },
+      advance: (sec: number) => {
+        for (let t = 0; t < sec; t += 1 / 60) step(1 / 60);
+      },
+      geometry: () => ({ W, H, R, mouth }),
+    };
+
+    return () => {
+      cancelAnimationFrame(raf);
+      ro?.disconnect();
+      stage.removeEventListener("pointerdown", onDown);
+      delete w.__starTest;
+    };
+  }, []);
+
+  return (
+    <div className="ss-stage" ref={stageRef} data-jar="0">
+      <HouseCanvas className="ss-sky" paint={paintSky} />
+      <div className="ss-twinkles" aria-hidden="true">
+        {twinkles.map((t, i) => (
+          <i
+            key={i}
+            style={{ left: t.left, top: t.top, width: t.size, height: t.size, animationDuration: `${t.dur}s`, animationDelay: `${t.delay}s` }}
+          />
+        ))}
+      </div>
+      <div className="ss-corner" ref={cornerRef} aria-hidden="true">
+        <div className="ss-glow" ref={glowRef} />
+        <HouseCanvas className="ss-ledge" paint={paintLedge} />
+        <div className="ss-pip" ref={pipRef}>
+          <HouseCanvas className="ss-pip-art calm" paint={PIP_CALM} />
+          <HouseCanvas className="ss-pip-art cheer" paint={PIP_CHEER} />
+        </div>
+        <div className="ss-jar" ref={jarRef}>
+          <JarArt setRef={jarSet} />
+        </div>
+      </div>
+      <div className="ss-stars" ref={starsRef} aria-hidden="true">
+        {TINT_OF.map((t, i) => (
+          <div key={i} className="ss-star" data-tint={t}>
+            <HouseCanvas className="ss-trail" paint={TRAIL_ART[i]!} />
+            <div className="ss-body">
+              <i className="ss-halo" />
+              <HouseCanvas className="ss-body-art" paint={BODY_ART[i]!} />
+            </div>
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
