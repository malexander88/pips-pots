+/* Shooting Star Catcher (replaces the bubble tubes). Flat 2D stage over an empty 3D view. */
+.ss-stage {
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+  overflow: hidden;
+  pointer-events: auto;
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+  -webkit-tap-highlight-color: transparent;
+  background: #0a0716;
+  contain: strict;
+}
+.ss-stage .ss-sky {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  display: block;
+}
+.ss-twinkles {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+}
+.ss-twinkles i {
+  position: absolute;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(240, 236, 252, 0.85) 0 30%, rgba(240, 236, 252, 0) 70%);
+  opacity: 0.15;
+  animation-name: ss-twinkle;
+  animation-timing-function: ease-in-out;
+  animation-iteration-count: infinite;
+  animation-direction: alternate;
+  will-change: opacity;
+}
+@keyframes ss-twinkle {
+  from { opacity: 0.12; }
+  to { opacity: 0.7; }
+}
+.ss-stars {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+}
+.ss-star {
+  position: absolute;
+  left: 0;
+  top: 0;
+  width: var(--ss-s);
+  height: var(--ss-s);
+  visibility: hidden;
+  will-change: transform;
+}
+.ss-star.is-on {
+  visibility: visible;
+}
+.ss-stage .ss-trail {
+  position: absolute;
+  width: calc(var(--ss-r) * 4.2);
+  height: calc(var(--ss-r) * 0.9);
+  inset: auto;
+  right: 50%;
+  top: calc(50% - var(--ss-r) * 0.45);
+  transform-origin: 100% 50%;
+  transition: opacity 0.6s ease;
+}
+.ss-stage .ss-star.is-caught .ss-trail {
+  opacity: 0;
+}
+.ss-body {
+  position: absolute;
+  inset: 0;
+  animation: ss-breathe 4.6s ease-in-out infinite alternate;
+}
+@keyframes ss-breathe {
+  from { transform: scale(1) rotate(-3deg); }
+  to { transform: scale(1.04) rotate(3deg); }
+}
+.ss-stage .ss-body-art {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+}
+.ss-halo {
+  position: absolute;
+  inset: 12%;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(250, 236, 200, 0.32) 0 35%, rgba(250, 236, 200, 0) 70%);
+  opacity: 0;
+  transition: opacity 0.7s ease;
+}
+.ss-star.is-caught .ss-halo {
+  opacity: 1;
+}
+.ss-star.is-flying .ss-halo {
+  opacity: 0.6;
+}
+/* Soft expanding ring where a star is caught. No burst, no flash. */
+.ss-ring {
+  position: absolute;
+  width: calc(var(--ss-r) * 2.4);
+  height: calc(var(--ss-r) * 2.4);
+  margin: calc(var(--ss-r) * -1.2) 0 0 calc(var(--ss-r) * -1.2);
+  border-radius: 50%;
+  border: 2px solid var(--ring, #ece3f8);
+  box-shadow: 0 0 12px 1px color-mix(in srgb, var(--ring, #ece3f8) 35%, transparent);
+  opacity: 0;
+  pointer-events: none;
+  animation: ss-ring 1.6s cubic-bezier(0.2, 0.6, 0.3, 1) forwards;
+}
+@keyframes ss-ring {
+  0% { opacity: 0; transform: scale(0.6); }
+  18% { opacity: 0.55; }
+  100% { opacity: 0; transform: scale(1.9); }
+}
+.ss-corner {
+  position: absolute;
+  right: 0;
+  bottom: 0;
+  pointer-events: none;
+}
+.ss-stage .ss-ledge {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+}
+.ss-jar,
+.ss-pip,
+.ss-glow {
+  position: absolute;
+}
+.ss-jar {
+  transform-origin: 50% 100%;
+}
+.ss-stage .ss-jar-art,
+.ss-stage .ss-pip-art {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+}
+.ss-glow {
+  --fill: 0;
+  border-radius: 50%;
+  background: radial-gradient(ellipse at 50% 62%, rgba(250, 214, 150, 0.5) 0, rgba(250, 214, 150, 0) 62%);
+  opacity: calc(0.18 + var(--fill) * 0.4);
+  transition: opacity 1.2s ease;
+}
+.ss-glow.is-full {
+  animation: ss-full 1.8s ease-in-out 2 alternate;
+}
+@keyframes ss-full {
+  from { opacity: 0.58; transform: scale(1); }
+  to { opacity: 0.85; transform: scale(1.12); }
+}
+.ss-stage .ss-pip-art.cheer {
+  opacity: 0;
+  transition: opacity 0.6s ease;
+}
+.ss-stage .ss-pip.is-cheer .ss-pip-art.cheer {
+  opacity: 1;
+}
+.ss-stage .ss-pip.is-cheer .ss-pip-art.calm {
+  opacity: 0;
+  transition: opacity 0.6s ease;
+}
+.ss-pip {
+  animation: ss-snooze 5s ease-in-out infinite alternate;
+  transform-origin: 50% 100%;
+}
+@keyframes ss-snooze {
+  from { transform: scale(1, 1); }
+  to { transform: scale(1.015, 0.985); }
+}
+/* A star floating back out of the jar when it empties. */
+.ss-out {
+  position: absolute;
+  pointer-events: none;
+  translate: -50% -50%;
+  animation: ss-out 3s ease-in-out forwards;
+}
+.ss-stage .ss-out canvas {
+  position: static;
+  display: block;
+}
+@keyframes ss-out {
+  0% { opacity: 0; transform: translate(0, 0) scale(0.6); }
+  15% { opacity: 0.85; }
+  100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(1); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .ss-body,
+  .ss-pip,
+  .ss-twinkles i {
+    animation: none;
+  }
+}
