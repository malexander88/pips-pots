+/**
+ * Shooting Star Catcher art (replaces the bubble tubes). Flat 2D canvas painters in the house
+ * style: navy outlines, soft fills, nothing bright. A bedtime sky, sleepy pastel stars, a small
+ * glass jar on a dusky ledge, and a sleepy Pip.
+ */
+import { paintHousePip } from "../house/pip";
+import { SCENE_INK } from "../house/tokens";
+
+type Ctx = CanvasRenderingContext2D;
+
+/** Soft gold, pale lilac, dusty blue. Deliberately low-chroma so nothing glares at bedtime. */
+export const STAR_TINTS = [
+  { base: "#f1d58e", light: "#fbecc4", dark: "#c9a55e", halo: "rgba(241, 213, 142, ", cheek: "rgba(230, 150, 140, 0.32)" },
+  { base: "#d6c6ee", light: "#ece3f8", dark: "#a896c8", halo: "rgba(214, 198, 238, ", cheek: "rgba(210, 140, 180, 0.30)" },
+  { base: "#aec4e2", light: "#d6e2f2", dark: "#7f98bf", halo: "rgba(174, 196, 226, ", cheek: "rgba(190, 140, 170, 0.28)" },
+] as const;
+
+/** Deterministic PRNG so the sky is the same picture on every repaint. */
+function rng(seed: number) {
+  let s = seed >>> 0;
+  return () => {
+    s = (s + 0x6d2b79f5) >>> 0;
+    let t = s;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+/** Five-point star path with rounded tips, centred on (x, y). */
+export function starPath(ctx: Ctx, x: number, y: number, r: number, rot = -Math.PI / 2, inner = 0.5) {
+  const pts: [number, number][] = [];
+  for (let i = 0; i < 10; i++) {
+    const a = rot + (i * Math.PI) / 5;
+    const rr = i % 2 === 0 ? r : r * inner;
+    pts.push([x + Math.cos(a) * rr, y + Math.sin(a) * rr]);
+  }
+  ctx.beginPath();
+  // Round each corner with arcTo so tips read soft and toy-like.
+  const n = pts.length;
+  const mid = (a: [number, number], b: [number, number]): [number, number] => [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
+  const start = mid(pts[n - 1]!, pts[0]!);
+  ctx.moveTo(start[0], start[1]);
+  for (let i = 0; i < n; i++) {
+    const p = pts[i]!;
+    const q = pts[(i + 1) % n]!;
+    const m = mid(p, q);
+    ctx.arcTo(p[0], p[1], m[0], m[1], i % 2 === 0 ? r * 0.16 : r * 0.1);
+  }
+  ctx.closePath();
+}
+
+/**
+ * The bedtime sky: a dithered black-to-purple gradient (no banding), a dense faint starfield of
+ * varied sizes, a few dim far-away galaxies and wisps of nebula. Painted once per size.
+ */
+export function paintSky(ctx: Ctx, w: number, h: number) {
+  paintSkyGradient(ctx, w, h);
+  paintStarfield(ctx, w, h, true);
+}
+
+/** The screen-fixed part of the sky: a dithered purple-to-black gradient (never rotates). */
+export function paintSkyGradient(ctx: Ctx, w: number, h: number) {
+  const canvas = ctx.canvas;
+  const W = canvas.width;
+  const H = canvas.height;
+  const k = W / Math.max(1, w);
+  // 1) Gradient straight into pixels with blue-noise-ish dither so 8-bit steps never band.
+  const img = ctx.createImageData(W, H);
+  const d = img.data;
+  const top = [44, 24, 74];
+  const midc = [24, 13, 44];
+  const bot = [5, 4, 12];
+  const rand = rng(7);
+  for (let y = 0; y < H; y++) {
+    const v = y / Math.max(1, H - 1);
+    // Smoothstep through three stops: purple at the top fading to near-black at the bottom.
+    let r: number, g: number, b: number;
+    if (v < 0.55) {
+      const t = v / 0.55;
+      const s = t * t * (3 - 2 * t);
+      r = top[0]! + (midc[0]! - top[0]!) * s;
+      g = top[1]! + (midc[1]! - top[1]!) * s;
+      b = top[2]! + (midc[2]! - top[2]!) * s;
+    } else {
+      const t = (v - 0.55) / 0.45;
+      const s = t * t * (3 - 2 * t);
+      r = midc[0]! + (bot[0]! - midc[0]!) * s;
+      g = midc[1]! + (bot[1]! - midc[1]!) * s;
+      b = midc[2]! + (bot[2]! - midc[2]!) * s;
+    }
+    let i = y * W * 4;
+    for (let x = 0; x < W; x++, i += 4) {
+      // Triangular dither, +/-1 LSB.
+      const n = rand() - rand();
+      d[i] = r + n;
+      d[i + 1] = g + n;
+      d[i + 2] = b + n * 1.2;
+      d[i + 3] = 255;
+    }
+  }
+  ctx.save();
+  ctx.setTransform(1, 0, 0, 1, 0, 0);
+  ctx.putImageData(img, 0, 0);
+  ctx.restore();
+}
+
+/**
+ * The turning part of the sky, on a transparent canvas: nebula wisps, a few dim far-away
+ * galaxies and a dense faint starfield. `screenFade` dims stars toward the bottom (only for the
+ * static menu card; in game the field turns, so a fixed overlay does that instead).
+ */
+export function paintStarfield(ctx: Ctx, w: number, h: number, screenFade = false) {
+  const k = ctx.canvas.width / Math.max(1, w);
+  const r2 = rng(11);
+  // 2) Faint nebula wisps (very low alpha, large soft blobs).
+  ctx.save();
+  ctx.globalCompositeOperation = "lighter";
+  for (let i = 0; i < 5; i++) {
+    const x = r2() * w;
+    const y = r2() * h * 0.7;
+    const rr = (0.25 + r2() * 0.35) * Math.max(w, h) * 0.5;
+    const g = ctx.createRadialGradient(x, y, 0, x, y, rr);
+    const hue = r2() < 0.5 ? "120, 70, 170" : "70, 80, 160";
+    g.addColorStop(0, `rgba(${hue}, 0.07)`);
+    g.addColorStop(1, `rgba(${hue}, 0)`);
+    ctx.fillStyle = g;
+    ctx.fillRect(x - rr, y - rr, rr * 2, rr * 2);
+  }
+  // 3) A few far-away galaxies: tilted soft ellipses with a faint core and arms.
+  const galaxies = Math.max(6, Math.round((w * h) / 70000));
+  for (let i = 0; i < galaxies; i++) {
+    const x = (0.12 + ((i + r2() * 0.6) / galaxies) * 0.8) * w;
+    const y = (screenFade ? 0.12 + r2() * 0.55 : 0.08 + r2() * 0.84) * h;
+    const size = (0.035 + r2() * 0.04) * Math.min(w, h) * 1.6;
+    const rot = r2() * Math.PI;
+    ctx.save();
+    ctx.translate(x, y);
+    ctx.rotate(rot);
+    ctx.scale(1, 0.38 + r2() * 0.22);
+    const g = ctx.createRadialGradient(0, 0, 0, 0, 0, size);
+    const tint = i % 2 ? "190, 170, 230" : "200, 185, 215";
+    g.addColorStop(0, `rgba(${tint}, 0.16)`);
+    g.addColorStop(0.25, `rgba(${tint}, 0.07)`);
+    g.addColorStop(1, `rgba(${tint}, 0)`);
+    ctx.fillStyle = g;
+    ctx.beginPath();
+    ctx.arc(0, 0, size, 0, Math.PI * 2);
+    ctx.fill();
+    ctx.fillStyle = `rgba(235, 225, 245, 0.22)`;
+    ctx.beginPath();
+    ctx.arc(0, 0, Math.max(0.8, size * 0.05), 0, Math.PI * 2);
+    ctx.fill();
+    ctx.restore();
+  }
+  ctx.restore();
+
+  // 3b) A few closer galaxies, big enough to read as galaxies: two tilted spirals and one
+  // edge-on. Soft and dim, low saturation. Only on the turning in-game layer.
+  // (In game these are separate small layers on the turning sky so a tap can spin one;
+  // see NEAR_GALAXIES / paintNearSpiral / paintEdgeGalaxy.)
+
+  // 4) Dense faint starfield, varied sizes; fewer and dimmer toward the bottom.
+  const area = w * h;
+  const count = Math.round(Math.min(3200, Math.max(500, area / 380)));
+  for (let i = 0; i < count; i++) {
+    const x = r2() * w;
+    const y = (screenFade ? Math.pow(r2(), 1.15) : r2()) * h;
+    const depth = r2();
+    const size = depth < 0.82 ? (0.35 + r2() * 0.45) : depth < 0.97 ? 0.8 + r2() * 0.5 : 1.3 + r2() * 0.6;
+    const fade = screenFade ? 1 - (y / h) * 0.45 : 1;
+    const a = (depth < 0.82 ? 0.25 + r2() * 0.3 : 0.45 + r2() * 0.35) * fade;
+    const tint = r2();
+    const col = tint < 0.7 ? "236, 232, 248" : tint < 0.85 ? "214, 204, 245" : "246, 232, 205";
+    ctx.fillStyle = `rgba(${col}, ${a.toFixed(3)})`;
+    ctx.beginPath();
+    ctx.arc(x, y, Math.max(0.5 / k, size * 0.6), 0, Math.PI * 2);
+    ctx.fill();
+    if (size > 1.4) {
+      // A few slightly bigger stars get a faint soft glow.
+      const g = ctx.createRadialGradient(x, y, 0, x, y, size * 3.2);
+      g.addColorStop(0, `rgba(${col}, ${(a * 0.25).toFixed(3)})`);
+      g.addColorStop(1, `rgba(${col}, 0)`);
+      ctx.fillStyle = g;
+      ctx.fillRect(x - size * 3.2, y - size * 3.2, size * 6.4, size * 6.4);
+    }
+  }
+}
+
+/** A soft round dot sprite (white), drawn once and tinted by globalAlpha/compositing. */
+let dotSprite: HTMLCanvasElement | null = null;
+function softDot() {
+  if (dotSprite) return dotSprite;
+  const c = document.createElement("canvas");
+  c.width = c.height = 64;
+  const x = c.getContext("2d")!;
+  const g = x.createRadialGradient(32, 32, 0, 32, 32, 32);
+  g.addColorStop(0, "rgba(255,255,255,1)");
+  g.addColorStop(0.4, "rgba(255,255,255,0.45)");
+  g.addColorStop(1, "rgba(255,255,255,0)");
+  x.fillStyle = g;
+  x.fillRect(0, 0, 64, 64);
+  dotSprite = c;
+  return c;
+}
+
+/** Spiral galaxy in local units (radius 1), already translated/rotated/squashed by the caller. */
+function spiralGalaxy(ctx: Ctx, size: number, seed: number, tint: [number, number, number]) {
+  const r = rng(seed);
+  const dot = softDot();
+  const [tr, tg, tb] = tint;
+  // Diffuse disc glow.
+  const disc = ctx.createRadialGradient(0, 0, 0, 0, 0, size);
+  disc.addColorStop(0, `rgba(${tr}, ${tg}, ${tb}, 0.16)`);
+  disc.addColorStop(0.45, `rgba(${tr}, ${tg}, ${tb}, 0.06)`);
+  disc.addColorStop(1, `rgba(${tr}, ${tg}, ${tb}, 0)`);
+  ctx.fillStyle = disc;
+  ctx.beginPath();
+  ctx.arc(0, 0, size, 0, Math.PI * 2);
+  ctx.fill();
+  // Two logarithmic arms of soft dots, thinning and fading outward.
+  ctx.save();
+  ctx.globalCompositeOperation = "lighter";
+  for (let arm = 0; arm < 2; arm++) {
+    for (let i = 0; i < 140; i++) {
+      const t = i / 139;
+      const th = arm * Math.PI + t * Math.PI * 2.4;
+      const rr = size * (0.1 + 0.86 * t) * (1 + (r() - 0.5) * 0.08);
+      const jitter = size * 0.05 * (r() - 0.5);
+      const x = Math.cos(th) * rr + jitter;
+      const y = Math.sin(th) * rr + jitter;
+      const ds = size * (0.2 - t * 0.12) * (0.7 + r() * 0.6);
+      ctx.globalAlpha = 0.07 * (1 - t * 0.7);
+      ctx.drawImage(dot, x - ds, y - ds, ds * 2, ds * 2);
+      if (r() < 0.25) {
+        // Tiny star-forming knots along the arm.
+        const k = size * 0.018;
+        ctx.globalAlpha = 0.3 * (1 - t * 0.6);
+        ctx.drawImage(dot, x - k, y - k, k * 2, k * 2);
+      }
+    }
+  }
+  ctx.restore();
+  // Soft warm core.
+  const core = ctx.createRadialGradient(0, 0, 0, 0, 0, size * 0.3);
+  core.addColorStop(0, "rgba(246, 236, 214, 0.55)");
+  core.addColorStop(0.35, "rgba(236, 222, 210, 0.22)");
+  core.addColorStop(1, "rgba(220, 205, 220, 0)");
+  ctx.fillStyle = core;
+  ctx.beginPath();
+  ctx.arc(0, 0, size * 0.3, 0, Math.PI * 2);
+  ctx.fill();
+}
+
+/**
+ * The closer galaxies, as placements on the square turning-sky layer of side D (unit = D * 0.4).
+ * kind "spiral": face-on art squashed by `tilt` and turned by `rot` in CSS; "edge": a thin lens.
+ * cx/cy are offsets from the layer centre in units; r is the art radius in units.
+ */
+export const NEAR_GALAXIES = [
+  { kind: "spiral", cx: Math.cos(-2.3) * 0.68, cy: Math.sin(-2.3) * 0.68, r: 0.3, tilt: 0.55, rot: 0.5, seed: 21, tint: [196, 186, 228] },
+  { kind: "spiral", cx: Math.cos(0.6) * 1.24, cy: Math.sin(0.6) * 1.24, r: 0.24, tilt: 0.75, rot: -0.9, seed: 33, tint: [184, 198, 226] },
+  { kind: "edge", cx: Math.cos(2.5), cy: Math.sin(2.5), r: 0.32, tilt: 1, rot: -0.35, seed: 0, tint: [206, 198, 230] },
+] as const;
+
+/** Face-on spiral filling a square canvas (radius = half the side, with a little margin). */
+export function paintNearSpiral(seed: number, tint: readonly [number, number, number]) {
+  return (ctx: Ctx, w: number, h: number) => {
+    ctx.save();
+    ctx.translate(w / 2, h / 2);
+    spiralGalaxy(ctx, Math.min(w, h) * 0.46, seed, [tint[0], tint[1], tint[2]]);
+    ctx.restore();
+  };
+}
+
+/** Edge-on galaxy: a thin glowing lens with a soft bulge and a faint dust lane, filling w x h. */
+export function paintEdgeGalaxy(ctx: Ctx, w: number, h: number) {
+  const L = w * 0.48;
+  ctx.save();
+  ctx.translate(w / 2, h / 2);
+  ctx.save();
+  ctx.scale(1, 0.13);
+  const lens = ctx.createRadialGradient(0, 0, 0, 0, 0, L);
+  lens.addColorStop(0, "rgba(232, 224, 236, 0.4)");
+  lens.addColorStop(0.4, "rgba(206, 198, 230, 0.15)");
+  lens.addColorStop(1, "rgba(206, 198, 230, 0)");
+  ctx.fillStyle = lens;
+  ctx.beginPath();
+  ctx.arc(0, 0, L, 0, Math.PI * 2);
+  ctx.fill();
+  ctx.restore();
+  ctx.save();
+  ctx.scale(1, 0.55);
+  const bulge = ctx.createRadialGradient(0, 0, 0, 0, 0, L * 0.2);
+  bulge.addColorStop(0, "rgba(246, 236, 216, 0.42)");
+  bulge.addColorStop(1, "rgba(246, 236, 216, 0)");
+  ctx.fillStyle = bulge;
+  ctx.beginPath();
+  ctx.arc(0, 0, L * 0.2, 0, Math.PI * 2);
+  ctx.fill();
+  ctx.restore();
+  ctx.strokeStyle = "rgba(20, 12, 36, 0.35)";
+  ctx.lineWidth = Math.max(1, L * 0.022);
+  ctx.lineCap = "round";
+  ctx.beginPath();
+  ctx.moveTo(-L * 0.72, L * 0.008);
+  ctx.lineTo(L * 0.72, L * 0.008);
+  ctx.stroke();
+  ctx.restore();
+}
+
+/** The rare golden wish star: a slightly larger, warmer star with a soft four-point glint. */
+export function paintWishStar(ctx: Ctx, w: number, h: number) {
+  const cx = w / 2;
+  const cy = h / 2;
+  const r = Math.min(w, h) * 0.26;
+  const halo = ctx.createRadialGradient(cx, cy, r * 0.4, cx, cy, Math.min(w, h) * 0.5);
+  halo.addColorStop(0, "rgba(255, 214, 130, 0.32)");
+  halo.addColorStop(1, "rgba(255, 214, 130, 0)");
+  ctx.fillStyle = halo;
+  ctx.fillRect(0, 0, w, h);
+  // Glint: two thin soft lines.
+  ctx.save();
+  ctx.globalCompositeOperation = "lighter";
+  for (const [sx, sy] of [[1, 0.06], [0.06, 1]] as const) {
+    const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, r * 1.9);
+    g.addColorStop(0, "rgba(255, 236, 190, 0.38)");
+    g.addColorStop(1, "rgba(255, 236, 190, 0)");
+    ctx.fillStyle = g;
+    ctx.beginPath();
+    ctx.ellipse(cx, cy, r * 1.9 * sx, r * 1.9 * sy, 0, 0, Math.PI * 2);
+    ctx.fill();
+  }
+  ctx.restore();
+  starPath(ctx, cx, cy, r);
+  const body = ctx.createRadialGradient(cx - r * 0.3, cy - r * 0.4, r * 0.1, cx, cy, r * 1.1);
+  body.addColorStop(0, "#fff0c4");
+  body.addColorStop(0.6, "#f4cf78");
+  body.addColorStop(1, "#d9a84c");
+  ctx.fillStyle = body;
+  ctx.fill();
+  ctx.strokeStyle = SCENE_INK;
+  ctx.lineWidth = Math.max(1.6, r * 0.09);
+  ctx.lineJoin = "round";
+  ctx.stroke();
+  paintSleepyFace(ctx, cx, cy + r * 0.12, r * 0.62, "rgba(230, 150, 120, 0.34)");
+}
+
+/** Sleepy face: closed, curved lids with lashes, a small smile, soft cheeks. */
+export function paintSleepyFace(ctx: Ctx, x: number, y: number, r: number, cheek: string, awake = 0) {
+  const lw = Math.max(1.6, r * 0.06);
+  ctx.save();
+  ctx.lineCap = "round";
+  ctx.lineJoin = "round";
+  ctx.strokeStyle = SCENE_INK;
+  ctx.lineWidth = lw;
+  const ey = y + r * 0.02;
+  for (const s of [-1, 1]) {
+    const ex = x + s * r * 0.3;
+    ctx.beginPath();
+    if (awake > 0) {
+      // Half-lidded: a lid line with a sliver of eye under it.
+      ctx.moveTo(ex - r * 0.13, ey - r * 0.01);
+      ctx.quadraticCurveTo(ex, ey - r * 0.05, ex + r * 0.13, ey - r * 0.01);
+      ctx.stroke();
+      ctx.fillStyle = SCENE_INK;
+      ctx.beginPath();
+      ctx.ellipse(ex, ey + r * 0.03, r * 0.07, r * 0.035, 0, 0, Math.PI);
+      ctx.fill();
+    } else {
+      ctx.moveTo(ex - r * 0.13, ey - r * 0.02);
+      ctx.quadraticCurveTo(ex, ey + r * 0.09, ex + r * 0.13, ey - r * 0.02);
+      ctx.stroke();
+    }
+  }
+  // Small smile.
+  ctx.lineWidth = lw * 0.9;
+  ctx.beginPath();
+  ctx.moveTo(x - r * 0.1, y + r * 0.2);
+  ctx.quadraticCurveTo(x, y + r * 0.28, x + r * 0.1, y + r * 0.2);
+  ctx.stroke();
+  // Cheeks.
+  ctx.fillStyle = cheek;
+  ctx.beginPath();
+  ctx.ellipse(x - r * 0.48, y + r * 0.16, r * 0.11, r * 0.07, 0, 0, Math.PI * 2);
+  ctx.ellipse(x + r * 0.48, y + r * 0.16, r * 0.11, r * 0.07, 0, 0, Math.PI * 2);
+  ctx.fill();
+  ctx.restore();
+}
+
+/** A sleepy pastel star with its soft halo, centred in a (w x h) square canvas. */
+export function paintStarBody(tint: number, awake = 0) {
+  const t = STAR_TINTS[tint % STAR_TINTS.length]!;
+  return (ctx: Ctx, w: number, h: number) => {
+    const cx = w / 2;
+    const cy = h / 2;
+    const r = Math.min(w, h) * 0.26;
+    // Halo: very soft, wide, low alpha.
+    const g = ctx.createRadialGradient(cx, cy, r * 0.4, cx, cy, Math.min(w, h) * 0.5);
+    g.addColorStop(0, `${t.halo}0.22)`);
+    g.addColorStop(0.5, `${t.halo}0.08)`);
+    g.addColorStop(1, `${t.halo}0)`);
+    ctx.fillStyle = g;
+    ctx.fillRect(0, 0, w, h);
+    const rot = -Math.PI / 2;
+    // Navy outline, then a gentle cel-shaded fill.
+    starPath(ctx, cx, cy, r, rot);
+    ctx.strokeStyle = SCENE_INK;
+    ctx.lineWidth = Math.max(2.4, r * 0.11);
+    ctx.lineJoin = "round";
+    ctx.stroke();
+    starPath(ctx, cx, cy, r, rot);
+    const fill = ctx.createRadialGradient(cx - r * 0.25, cy - r * 0.3, r * 0.05, cx, cy, r * 1.1);
+    fill.addColorStop(0, t.light);
+    fill.addColorStop(0.55, t.base);
+    fill.addColorStop(1, t.dark);
+    ctx.fillStyle = fill;
+    ctx.fill();
+    // Soft gloss on the upper-left arm.
+    ctx.save();
+    starPath(ctx, cx, cy, r, rot);
+    ctx.clip();
+    ctx.fillStyle = "rgba(255, 255, 255, 0.18)";
+    ctx.beginPath();
+    ctx.ellipse(cx - r * 0.28, cy - r * 0.38, r * 0.26, r * 0.12, -0.6, 0, Math.PI * 2);
+    ctx.fill();
+    ctx.restore();
+    paintSleepyFace(ctx, cx, cy + r * 0.05, r, t.cheek, awake);
+  };
+}
+
+/** Thin faint trail of tiny dots, fading out to the left (the element is rotated to the path). */
+export function paintTrail(tint: number) {
+  const t = STAR_TINTS[tint % STAR_TINTS.length]!;
+  return (ctx: Ctx, w: number, h: number) => {
+    const cy = h / 2;
+    const n = 9;
+    for (let i = 0; i < n; i++) {
+      const f = i / (n - 1); // 0 at the star end (right), 1 at the far tail
+      const x = w * (1 - f) - h * 0.15;
+      const rr = h * (0.13 - f * 0.09);
+      ctx.fillStyle = `${t.halo}${(0.32 * (1 - f) + 0.04).toFixed(3)})`;
+      ctx.beginPath();
+      ctx.ellipse(x, cy, rr * 1.8, rr, 0, 0, Math.PI * 2);
+      ctx.fill();
+    }
+  };
+}
+
+/** A tiny star for the jar contents and the floating-out sparkles. */
+export function paintTinyStar(tint: number) {
+  const t = STAR_TINTS[tint % STAR_TINTS.length]!;
+  return (ctx: Ctx, w: number, h: number) => {
+    const r = Math.min(w, h) * 0.38;
+    starPath(ctx, w / 2, h / 2, r);
+    ctx.strokeStyle = SCENE_INK;
+    ctx.lineWidth = Math.max(1.4, r * 0.14);
+    ctx.lineJoin = "round";
+    ctx.stroke();
+    ctx.fillStyle = t.base;
+    ctx.fill();
+  };
+}
+
+export const JAR_CAP = 8;
+/** Where the little stars sit inside the jar, bottom up (fractions of the jar body). */
+const JAR_SLOTS: [number, number, number][] = [
+  [0.34, 0.9, 0.2], [0.62, 0.9, -0.3], [0.48, 0.79, 0.5], [0.28, 0.72, -0.1],
+  [0.7, 0.72, 0.3], [0.5, 0.62, -0.4], [0.33, 0.53, 0.1], [0.66, 0.53, -0.2],
+];
+
+/**
+ * The small glass jar, sat on its ledge, with `count` little stars inside. Low prominence:
+ * dusky glass, a navy outline and only a dim warm glow that grows a little as it fills.
+ */
+export function paintJar(count: number) {
+  return (ctx: Ctx, w: number, h: number) => {
+    const lw = Math.max(2.2, w * 0.035);
+    const bodyTop = h * 0.2;
+    const bodyBot = h * 0.97;
+    const left = w * 0.1;
+    const right = w * 0.9;
+    const rad = w * 0.2;
+    const body = () => {
+      ctx.beginPath();
+      ctx.moveTo(left + rad * 0.6, bodyTop);
+      ctx.lineTo(right - rad * 0.6, bodyTop);
+      ctx.quadraticCurveTo(right, bodyTop, right, bodyTop + rad);
+      ctx.lineTo(right, bodyBot - rad);
+      ctx.quadraticCurveTo(right, bodyBot, right - rad, bodyBot);
+      ctx.lineTo(left + rad, bodyBot);
+      ctx.quadraticCurveTo(left, bodyBot, left, bodyBot - rad);
+      ctx.lineTo(left, bodyTop + rad);
+      ctx.quadraticCurveTo(left, bodyTop, left + rad * 0.6, bodyTop);
+      ctx.closePath();
+    };
+    // Glass: dusky blue-grey, mostly see-through.
+    body();
+    ctx.fillStyle = "rgba(70, 82, 120, 0.42)";
+    ctx.fill();
+    // Inner warm glow, scaled by fill.
+    const fillK = Math.min(1, count / JAR_CAP);
+    ctx.save();
+    body();
+    ctx.clip();
+    const g = ctx.createRadialGradient(w * 0.5, h * 0.78, 0, w * 0.5, h * 0.7, h * 0.7);
+    g.addColorStop(0, `rgba(250, 214, 150, ${(0.08 + fillK * 0.28).toFixed(3)})`);
+    g.addColorStop(1, "rgba(250, 214, 150, 0)");
+    ctx.fillStyle = g;
+    ctx.fillRect(0, 0, w, h);
+    const bw = right - left;
+    const bh = bodyBot - bodyTop;
+    for (let i = 0; i < Math.min(count, JAR_CAP); i++) {
+      const [fx, fy, rot] = JAR_SLOTS[i]!;
+      const t = STAR_TINTS[i % STAR_TINTS.length]!;
+      const sr = bw * 0.17;
+      const x = left + bw * fx;
+      const y = bodyTop + bh * fy;
+      starPath(ctx, x, y, sr, -Math.PI / 2 + rot);
+      ctx.strokeStyle = SCENE_INK;
+      ctx.lineWidth = Math.max(1.4, sr * 0.16);
+      ctx.lineJoin = "round";
+      ctx.stroke();
+      ctx.fillStyle = t.base;
+      ctx.fill();
+    }
+    // Glass highlight streak.
+    ctx.fillStyle = "rgba(220, 228, 250, 0.16)";
+    ctx.beginPath();
+    ctx.roundRect(left + bw * 0.1, bodyTop + bh * 0.1, bw * 0.12, bh * 0.72, bw * 0.06);
+    ctx.fill();
+    ctx.restore();
+    body();
+    ctx.strokeStyle = SCENE_INK;
+    ctx.lineWidth = lw;
+    ctx.stroke();
+    // Neck and lid.
+    ctx.beginPath();
+    ctx.roundRect(w * 0.2, h * 0.05, w * 0.6, h * 0.13, w * 0.06);
+    ctx.fillStyle = "#4a5a86";
+    ctx.fill();
+    ctx.strokeStyle = SCENE_INK;
+    ctx.lineWidth = lw;
+    ctx.stroke();
+    ctx.fillStyle = "rgba(200, 210, 240, 0.18)";
+    ctx.fillRect(w * 0.26, h * 0.08, w * 0.3, h * 0.03);
+  };
+}
+
+/**
+ * The little moon in the bottom-right corner that the jar and Pip sit on: the top of a small
+ * grey-silver moon rising from the bottom edge, with soft craters and gentle shading, kept dim.
+ * The dome is a circle segment whose chord is the canvas bottom edge: width w, height h.
+ */
+export function moonSurfaceY(w: number, h: number, x: number) {
+  const R = (w * w) / 4 / h / 2 + h / 2;
+  const dx = x - w / 2;
+  return R - Math.sqrt(Math.max(0, R * R - dx * dx));
+}
+
+export function paintMoon(ctx: Ctx, w: number, h: number) {
+  paintMoonShade(ctx, w, h, false);
+}
+
+/** The moon at full nightlight brightness, layered over paintMoon and faded in by opacity. */
+export function paintMoonLit(ctx: Ctx, w: number, h: number) {
+  paintMoonShade(ctx, w, h, true);
+}
+
+function paintMoonShade(ctx: Ctx, w: number, h: number, lit: boolean) {
+  const R = (w * w) / 4 / h / 2 + h / 2;
+  const cx = w / 2;
+  const cy = R;
+  const dome = () => {
+    ctx.beginPath();
+    ctx.arc(cx, cy, R, 0, Math.PI * 2);
+  };
+  ctx.save();
+  // Faint cool rim glow behind the moon.
+  const halo = ctx.createRadialGradient(cx, cy, R * 0.96, cx, cy, R + h * 0.22);
+  halo.addColorStop(0, "rgba(190, 196, 225, 0.12)");
+  halo.addColorStop(1, "rgba(190, 196, 225, 0)");
+  // (The rim glow is the .ss-moonglow layer, which can spread past this canvas's edges.)
+  void halo;
+  // Body: silver-grey, lit softly from the upper left, darker toward the lower right.
+  dome();
+  const g = ctx.createRadialGradient(cx - w * 0.22, h * 0.05, h * 0.05, cx, cy, R);
+  // Lit: a soft warm-silver nightlight glow, never white.
+  g.addColorStop(0, lit ? "#e6e2d8" : "#bcbcc4");
+  g.addColorStop(0.35, lit ? "#cfccc8" : "#9c9ca6");
+  g.addColorStop(0.75, lit ? "#a9a8b0" : "#76767f");
+  g.addColorStop(1, lit ? "#86869a" : "#56566a");
+  ctx.fillStyle = g;
+  ctx.fill();
+  ctx.clip();
+  // Soft maria (darker plains).
+  ctx.fillStyle = "rgba(78, 78, 90, 0.2)";
+  ctx.beginPath();
+  ctx.ellipse(w * 0.36, h * 0.62, w * 0.16, h * 0.2, -0.2, 0, Math.PI * 2);
+  ctx.ellipse(w * 0.7, h * 0.78, w * 0.13, h * 0.16, 0.3, 0, Math.PI * 2);
+  ctx.fill();
+  // Craters: a dark bowl, a lit lower-right rim and a shadowed upper-left lip.
+  const craters: [number, number, number][] = [
+    [0.18, 0.55, 0.075], [0.46, 0.4, 0.05], [0.58, 0.72, 0.09], [0.84, 0.6, 0.06],
+    [0.3, 0.85, 0.055], [0.72, 0.36, 0.035], [0.1, 0.86, 0.04], [0.92, 0.88, 0.045],
+  ];
+  for (const [fx, fy, fr] of craters) {
+    const x = w * fx;
+    const y = h * fy;
+    const r = w * fr;
+    const ry = r * 0.6;
+    // Soft lit lip on the lower right, then a soft shadowed bowl offset up-left.
+    ctx.save();
+    ctx.translate(x, y);
+    ctx.scale(1, ry / r);
+    const lip = ctx.createRadialGradient(r * 0.18, r * 0.2, r * 0.55, r * 0.18, r * 0.2, r * 1.1);
+    lip.addColorStop(0, "rgba(214, 216, 232, 0)");
+    lip.addColorStop(0.5, "rgba(214, 216, 232, 0.07)");
+    lip.addColorStop(1, "rgba(214, 216, 232, 0)");
+    ctx.fillStyle = lip;
+    ctx.beginPath();
+    ctx.arc(r * 0.12, r * 0.14, r * 1.15, 0, Math.PI * 2);
+    ctx.fill();
+    const bowl = ctx.createRadialGradient(-r * 0.1, -r * 0.12, 0, -r * 0.05, -r * 0.05, r);
+    bowl.addColorStop(0, "rgba(58, 58, 70, 0.34)");
+    bowl.addColorStop(0.6, "rgba(64, 64, 76, 0.22)");
+    bowl.addColorStop(1, "rgba(64, 64, 76, 0)");
+    ctx.fillStyle = bowl;
+    ctx.beginPath();
+    ctx.arc(0, 0, r, 0, Math.PI * 2);
+    ctx.fill();
+    ctx.restore();
+  }
+  // A few tiny pocks.
+  const r3 = rng(5);
+  ctx.fillStyle = "rgba(64, 64, 78, 0.26)";
+  for (let i = 0; i < 26; i++) {
+    const x = r3() * w;
+    const y = h * (0.15 + r3() * 0.85);
+    ctx.beginPath();
+    ctx.ellipse(x, y, w * (0.006 + r3() * 0.008), w * 0.005, 0, 0, Math.PI * 2);
+    ctx.fill();
+  }
+  // Night dimming so the moon stays calm.
+  if (!lit) {
+    ctx.fillStyle = "rgba(24, 18, 52, 0.22)";
+    ctx.fillRect(0, 0, w, h);
+  }
+  ctx.restore();
+}
+
+/** Small sleepy Pip (eyes closed), tinted for the night so he stays a quiet companion. */
+export function paintSleepyPip(cheer = 0) {
+  return (ctx: Ctx, w: number, h: number) => {
+    const r = Math.min(w / 2.7, h / 3.25);
+    const x = w / 2;
+    const y = r * 1.15;
+    const off = document.createElement("canvas");
+    off.width = ctx.canvas.width;
+    off.height = ctx.canvas.height;
+    const o = off.getContext("2d");
+    if (!o) return;
+    o.setTransform(ctx.getTransform());
+    paintHousePip(o, x, y, r, w, { cheer });
+    // Close the eyes: paint lids over them, then a sleepy curve.
+    for (const s of [-1, 1]) {
+      const ex = x + s * r * 0.4;
+      const ey = y - r * 0.2;
+      o.fillStyle = "#ffdc5c";
+      o.beginPath();
+      o.arc(ex, ey, r * 0.27, 0, Math.PI * 2);
+      o.fill();
+      o.strokeStyle = SCENE_INK;
+      o.lineWidth = Math.max(1.6, r * 0.07);
+      o.lineCap = "round";
+      o.beginPath();
+      o.moveTo(ex - r * 0.15, ey - r * 0.01);
+      o.quadraticCurveTo(ex, ey + r * 0.12, ex + r * 0.15, ey - r * 0.01);
+      o.stroke();
+    }
+    // Night tint over Pip only.
+    o.save();
+    o.setTransform(1, 0, 0, 1, 0, 0);
+    o.globalCompositeOperation = "source-atop";
+    o.fillStyle = "rgba(40, 30, 90, 0.34)";
+    o.fillRect(0, 0, off.width, off.height);
+    o.restore();
+    ctx.save();
+    ctx.setTransform(1, 0, 0, 1, 0, 0);
+    ctx.drawImage(off, 0, 0);
+    ctx.restore();
+  };
+}
+
+/** Menu card: the bedtime sky with a sleepy star drifting toward a small glowing jar. */
+export function paintStarsCard(ctx: Ctx, w: number, h: number) {
+  paintSky(ctx, w, h);
+  // Ledge, jar and stars, in proportions that read at card size.
+  ctx.save();
+  ctx.translate(w * 0.56, h * 0.76);
+  paintMoon(ctx, w * 0.4, h * 0.24);
+  ctx.restore();
+  ctx.save();
+  const g = ctx.createRadialGradient(w * 0.78, h * 0.68, 0, w * 0.78, h * 0.68, h * 0.26);
+  g.addColorStop(0, "rgba(250, 214, 150, 0.28)");
+  g.addColorStop(1, "rgba(250, 214, 150, 0)");
+  ctx.fillStyle = g;
+  ctx.fillRect(0, 0, w, h);
+  ctx.translate(w * 0.72, h * 0.5);
+  paintJar(5)(ctx, w * 0.12, h * 0.28);
+  ctx.restore();
+  const big = Math.min(w, h) * 0.75;
+  ctx.save();
+  ctx.translate(w * 0.4 - big / 2, h * 0.38 - big / 2);
+  ctx.save();
+  ctx.translate(-big * 0.35, big * 0.38);
+  ctx.rotate(0.28);
+  paintTrail(0)(ctx, big * 0.6, big * 0.12);
+  ctx.restore();
+  paintStarBody(0)(ctx, big, big);
+  ctx.restore();
+  const small = Math.min(w, h) * 0.4;
+  ctx.save();
+  ctx.translate(w * 0.2 - small / 2, h * 0.75 - small / 2);
+  paintStarBody(2)(ctx, small, small);
+  ctx.restore();
+  ctx.save();
+  ctx.translate(w * 0.82 - small / 2, h * 0.22 - small / 2);
+  paintStarBody(1)(ctx, small, small);
+  ctx.restore();
+}
