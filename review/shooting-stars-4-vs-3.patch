-export const TWINKLE_BEAT_SEC = 0.42;
+
+const LETTER_KEY: Record<string, number> = { C: 0, D: 1, E: 2, F: 3, G: 4, A: 5, B: 6, c: 7 };
+
+/** A song as [key index (or -1 for a rest), beats]. */
+export type Song = { id: string; beat: number; notes: [number, number][] };
+
+export function parseSong(src: string): [number, number][] {
+  return src
+    .trim()
+    .split(/\s+/)
+    .map((tok) => {
+      const m = /^([CDEFGABcr])(\d*\.?\d*)$/.exec(tok);
+      if (!m) throw new Error(`bad note ${tok}`);
+      const beats = m[2] ? Number(m[2]) : 1;
+      return [m[1] === "r" ? -1 : LETTER_KEY[m[1]!]!, beats] as [number, number];
+    });
+}
+
+export const SONGS: Song[] = SONG_SRC.map((s) => ({ id: s.id, beat: s.beat, notes: parseSong(s.notes) }));
+
+/** Kept for older review hooks: the first song (Twinkle, Twinkle, Little Star). */
+export const TWINKLE: [number, number][] = SONGS[0]!.notes;
+export const TWINKLE_BEAT_SEC = SONGS[0]!.beat;
