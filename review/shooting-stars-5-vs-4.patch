diff -ruN s4/game/src/game/lifecycle.ts s5/game/src/game/lifecycle.ts
--- s4/game/src/game/lifecycle.ts	1970-01-01 01:00:00.000000000 +0100
+++ s5/game/src/game/lifecycle.ts	2026-11-14 17:00:47.395386917 +0000
@@ -0,0 +1,111 @@
+/**
+ * App lifecycle: the one place that decides "Pip's Pots is in the background".
+ *
+ * The app counts as paused while any reason holds:
+ *  - hidden: the page is hidden (home button, recents, screen off, another app) or pagehide;
+ *  - freeze: the browser froze the page (Page Lifecycle "freeze" event);
+ *  - blur:   the window lost focus (notification shade, a system dialog, another window);
+ *  - native: the Android wrapper said the Activity paused (window.__pipLifecycle.pause()).
+ *
+ * While paused, the audio bus is suspended (see audio.suspendForBackground), and the game loops
+ * (sim.step, the star sky, the painted pots, colouring's auto-advance, the piano song) stand
+ * still, so coming back finds the same game in the same state. There is no pause button: it all
+ * just carries on when the app is in front again.
+ */
+export type PauseReason = "hidden" | "freeze" | "blur" | "native";
+
+const reasons = new Set<PauseReason>();
+const listeners = new Set<(paused: boolean) => void>();
+let paused = false;
+let installed = false;
+
+type LifecycleWindow = Window & {
+  __pipPaused?: boolean;
+  __pipLifecycle?: {
+    pause: () => void;
+    resume: () => void;
+    paused: () => boolean;
+    reasons: () => PauseReason[];
+    log: { t: number; paused: boolean; why: string }[];
+  };
+};
+
+export function isAppPaused() {
+  return paused;
+}
+
+/** Called with true when the app goes to the background and false when it comes back. */
+export function onAppPause(fn: (paused: boolean) => void) {
+  listeners.add(fn);
+  return () => {
+    listeners.delete(fn);
+  };
+}
+
+function update(why: string) {
+  const next = reasons.size > 0;
+  if (next === paused) return;
+  paused = next;
+  if (typeof window !== "undefined") {
+    const w = window as LifecycleWindow;
+    w.__pipPaused = paused;
+    w.__pipLifecycle?.log.push({ t: Math.round(performance.now()), paused, why });
+    if (document.documentElement) document.documentElement.dataset.appPaused = paused ? "1" : "0";
+  }
+  for (const fn of [...listeners]) {
+    try {
+      fn(paused);
+    } catch (err) {
+      console.error(err);
+    }
+  }
+}
+
+function add(r: PauseReason, why: string = r) {
+  reasons.add(r);
+  update(why);
+}
+
+function clear(rs: PauseReason[], why: string) {
+  for (const r of rs) reasons.delete(r);
+  update(why);
+}
+
+/** Wire the page lifecycle events once. Safe to call more than once. */
+export function installLifecycle() {
+  if (installed || typeof window === "undefined" || typeof document === "undefined") return;
+  installed = true;
+  const w = window as LifecycleWindow;
+  w.__pipPaused = false;
+  w.__pipLifecycle = {
+    // The Android wrapper calls these from Activity.onPause / onResume.
+    pause: () => add("native"),
+    // Back in front: the Activity resumed, so the page is visible and focused as well.
+    resume: () => clear(["native", "hidden", "freeze", "blur"], "native-resume"),
+    paused: () => paused,
+    reasons: () => [...reasons],
+    log: [],
+  };
+  const onVis = () => {
+    if (document.visibilityState === "hidden") add("hidden", "visibilitychange");
+    // A page that becomes visible is in front again, whatever focus events did or did not fire.
+    else clear(["hidden", "freeze", "blur"], "visibilitychange");
+  };
+  document.addEventListener("visibilitychange", onVis);
+  window.addEventListener("pagehide", () => add("hidden", "pagehide"));
+  window.addEventListener("pageshow", () => {
+    if (document.visibilityState !== "hidden") clear(["hidden", "freeze"], "pageshow");
+  });
+  document.addEventListener("freeze", () => add("freeze"));
+  document.addEventListener("resume", () => clear(["freeze"], "resume"));
+  window.addEventListener("blur", () => add("blur"));
+  window.addEventListener("focus", () => clear(["blur"], "focus"));
+  // A touch means the app is in front. This runs first (capture, installed before the game's
+  // own listeners), so the tap that brings it back is heard.
+  const onTouch = () => {
+    if (reasons.has("blur")) clear(["blur"], "pointerdown");
+  };
+  window.addEventListener("pointerdown", onTouch, true);
+  window.addEventListener("keydown", onTouch, true);
+  if (document.visibilityState === "hidden") add("hidden", "boot-hidden");
+}
